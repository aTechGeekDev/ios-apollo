--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -5592,6 +5592,56 @@
 /* (xnu 0164) + the Files app, its daemon and the "On My iPhone" provider: their os_log mirrored (libsweet-fix); (0166) + usermanagerd; (0168) + configd, which starts the jailbreak installer */
 #define SWEET_INJECT_BUILTIN    "/usr/local/lib/libsweet-fix.dylib:ScreenshotServicesService,fileproviderd,Files,LocalStorageFileProvider,usermanagerd,configd"
 
+/*
+ * (xnu 0175) Libraries for SpringBoard and the apps (/Applications, the installed apps' bundles) that no group above
+ * names, each switched on by an option (a boot-arg or mkadt.py --option NAME=1; apollo_option(), bsd/dev/apollo_pmic.c)
+ * and inserted only when its file is there (dyld ends a program whose inserted library is missing):
+ *   apollo_ui=1      /usr/local/lib/libsweet-ui.dylib (userland/ui): the iPhone 14 Pro's status bar layout
+ *                    (around the Dynamic Island) instead of the iPhone X's, whose clock sits under the punch hole;
+ *   apollo_tweaks=1  the rootless jailbreak's tweak loader, which ElleKit installs (Sileo: the ElleKit package).
+ * Daemons get nothing: a broken library can only take apps and the home screen down, and the boot image's options
+ * turn it off again.
+ */
+extern int apollo_option(const char *name, int fallback);
+#define SWEET_UI_LIBRARY        "/usr/local/lib/libsweet-ui.dylib"
+#define SWEET_TWEAK_LOADER      "/var/jb/usr/lib/TweakLoader.dylib"
+
+static bool
+sweet_exec_file_exists(const char *path)
+{
+	vnode_t vp = NULLVP;
+
+	if (vnode_lookup(path, 0, &vp, vfs_context_kernel()) != 0) {
+		return false;
+	}
+	vnode_put(vp);
+	return true;
+}
+
+static bool
+sweet_exec_tweaks(const char *path, char *env, size_t size)
+{
+	static const char *const apps[] = { "/Applications/", "/private/var/containers/Bundle/Application/",
+		                            "/var/containers/Bundle/Application/" };
+	bool want = strcmp(path, "/System/Library/CoreServices/SpringBoard.app/SpringBoard") == 0;
+	bool ui, tweaks;
+
+	for (size_t i = 0; !want && i < sizeof(apps) / sizeof(apps[0]); i++) {
+		want = strncmp(path, apps[i], strlen(apps[i])) == 0;
+	}
+	if (!want) {
+		return false;
+	}
+	ui = apollo_option("apollo_ui", 0) >= 1 && sweet_exec_file_exists(SWEET_UI_LIBRARY);
+	tweaks = apollo_option("apollo_tweaks", 0) >= 1 && sweet_exec_file_exists(SWEET_TWEAK_LOADER);
+	if (!ui && !tweaks) {
+		return false;
+	}
+	snprintf(env, size, "DYLD_INSERT_LIBRARIES=%s%s%s", ui ? SWEET_UI_LIBRARY : "", ui && tweaks ? ":" : "",
+	    tweaks ? SWEET_TWEAK_LOADER : "");
+	return true;
+}
+
 static bool
 sweet_exec_inject(struct image_params *imgp, char *env, size_t size)
 {
@@ -5642,7 +5692,7 @@
 		}
 		group += grouplen + (group[grouplen] == ';');
 	}
-	return false;
+	return sweet_exec_tweaks(path, env, size);
 }
