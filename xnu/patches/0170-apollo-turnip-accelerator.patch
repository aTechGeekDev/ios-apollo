+/*
+ * (xnu 0170) The GPU for the Turnip client (SweetAccelerator.cpp, the NativeAdreno ABI): under gGPULock as Mesa's
+ * submissions are, so the two share the ring, and a hang in either is recovered the same way (0163).
+ */
+#define GPU_V2_WINDOWS          64              /* window i: (i + 1) * 4 GiB, 4 GiB long, one per client */
+static uint64_t gV2Windows;
+
+extern "C" {
+int sweet_gpu_v2_window(uint64_t *base, uint64_t *size);
+void sweet_gpu_v2_window_free(uint64_t base);
+bool sweet_gpu_v2_map(uint64_t iova, const uint64_t *pages, uint32_t n, bool read_only);
+void sweet_gpu_v2_unmap(uint64_t iova, uint64_t bytes);
+uint32_t sweet_gpu_v2_submit(const uint64_t *iova, const uint32_t *dwords, uint32_t n, bool *busy);
+int sweet_gpu_v2_wait(uint32_t fence, uint64_t timeout_ns);
+}
+
+int
+sweet_gpu_v2_window(uint64_t *base, uint64_t *size)
+{
+	if (gGPULock == NULL) {
+		return ENXIO;
+	}
+	IOLockLock(gGPULock);
+	for (unsigned i = 0; i < GPU_V2_WINDOWS; i++) {
+		if (!(gV2Windows & (1ull << i))) {
+			gV2Windows |= 1ull << i;
+			IOLockUnlock(gGPULock);
+			*base = (uint64_t)(i + 1) << 32;
+			*size = 1ull << 32;
+			return 0;
+		}
+	}
+	IOLockUnlock(gGPULock);
+	return ENOSPC;
+}
+
+void
+sweet_gpu_v2_window_free(uint64_t base)
+{
+	uint64_t i = (base >> 32) - 1;
+
+	if (gGPULock == NULL || i >= GPU_V2_WINDOWS) {
+		return;
+	}
+	IOLockLock(gGPULock);
+	gV2Windows &= ~(1ull << i);
+	IOLockUnlock(gGPULock);
+}
+
+/* n 4K pages at iova (inside a window); false: a page table could not be had */
+bool
+sweet_gpu_v2_map(uint64_t iova, const uint64_t *pages, uint32_t n, bool read_only)
+{
+	bool ok = true;
+
+	IOLockLock(gGPULock);
+	for (uint32_t i = 0; ok && i < n; i++) {
+		ok = sweet_gpu_map(iova + 4096ull * i, pages[i], read_only);
+	}
+	sweet_gpu_mapped();
+	IOLockUnlock(gGPULock);
+	return ok;
+}
+
+void
+sweet_gpu_v2_unmap(uint64_t iova, uint64_t bytes)
+{
+	IOLockLock(gGPULock);
+	sweet_gpu_unmap(iova, bytes);
+	IOLockUnlock(gGPULock);
+}
+
+/* Up to 16 IBs as one submission (sweet_gpu_submit wraps them as Linux's a6xx_submit); 0: none taken */
+uint32_t
+sweet_gpu_v2_submit(const uint64_t *iova, const uint32_t *dwords, uint32_t n, bool *busy)
+{
+	uint32_t fence;
+
+	*busy = false;
+	IOLockLock(gGPULock);
+	if (gGPUStopped) {
+		IOLockUnlock(gGPULock);
+		return 0;
+	}
+	sweet_gpu_to_memory(NULL, 0);
+	fence = sweet_gpu_submit(iova, dwords, n);
+	if (fence == 0) {
+		sweet_gpu_report("the ring stays full (Turnip)");
+		if (sweet_gpu_recover()) {
+			fence = sweet_gpu_submit(iova, dwords, n);
+		}
+		gGPUStopped = fence == 0;
+		*busy = !gGPUStopped;
+	}
+	IOLockUnlock(gGPULock);
+	return fence;
+}
+
+/* 0 once the fence has passed; ETIMEDOUT. A timeout of 0 looks once; a long wait that comes to nothing recovers the core. */
+int
+sweet_gpu_v2_wait(uint32_t fence, uint64_t timeout_ns)
+{
+	bool done;
+
+	IOLockLock(gGPULock);
+	if (timeout_ns == 0) {
+		done = sweet_gpu_done(fence);
+	} else {
+		uint64_t ms = (timeout_ns + NSEC_PER_MSEC - 1) / NSEC_PER_MSEC;
+		done = gpuWait(fence, ms > GPU_PATIENCE_MS ? GPU_PATIENCE_MS : ms);
+	}
+	IOLockUnlock(gGPULock);
+	return done ? 0 : ETIMEDOUT;
 }
 
