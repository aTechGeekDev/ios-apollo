+static bool
+test_key(uint8_t amp, bool unlock)
+{
+	return unlock ? reg_write(amp, REG_TEST_KEY, 0x55) && reg_write(amp, REG_TEST_KEY, 0xaa) :
+	       reg_write(amp, REG_TEST_KEY, 0xcc) && reg_write(amp, REG_TEST_KEY, 0x33);
+}
