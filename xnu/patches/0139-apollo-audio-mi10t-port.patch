+	bool rx2_asprx2;        /* Android: only the earpiece's DSP RX2 comes from ASPRX2 (with ASP_RX2_EN) and its ASP TX1 carries DSPTX1;
+	                         * the speaker's DSP RX2 is ASPRX1 and its ASP TX2 carries DSPTX1 */
