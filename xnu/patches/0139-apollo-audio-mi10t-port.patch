+			    channel->their_intents[n].size, channel->their_intents[n].in_use ? ", in use" : "");
+		}
+	}
+	printf("apollo adsp: glink:   %u intents of the DSP's on \"%s\", %u in use, the largest %u bytes\n", there, channel->name, in_use,
