+/* FROM renamed to TO, the folders on TO's way made (root's, 0755) if missing; EEXIST if TO is there already. */
+static int
+sweet_file_move(const char *from, const char *to)
+{
+	static const struct sweet_owner root = { 0, 0, 0755 };
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int error;
+
+	if (vnode_lookup(to, VNODE_LOOKUP_NOFOLLOW, &vp, ctx) == 0) {
+		vnode_put(vp);
+		return EEXIST;
+	}
+	error = sweet_kernel_rename(from, to);
+	if (error == ENOENT && vnode_lookup(from, VNODE_LOOKUP_NOFOLLOW, &vp, ctx) == 0) {
+		/* (FROM is there: TO's folder is not) */
+		vnode_put(vp);
+		if ((error = sweet_file_folders(to, &root)) == 0) {
+			error = sweet_kernel_rename(from, to);
+		}
+	}
+	return error;
+}
