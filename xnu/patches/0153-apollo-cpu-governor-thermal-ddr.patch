+	nanoseconds_to_absolutetime((uint64_t)GOV_PERIOD_MS * NSEC_PER_MSEC, &period_abs);
+	nanoseconds_to_absolutetime((uint64_t)stats_s * NSEC_PER_SEC, &stats_abs);
+	delay_for_interval(GOV_START_S * 1000, NSEC_PER_MSEC);
+	printf("SWEET CPUFREQ: the governor runs: every %u ms, temperature limit %u C%s, the memory bus following the load\n",
+	    GOV_PERIOD_MS, limit, limit ? "" : " (none)");
+	stats_since = at_prev = mach_absolute_time();
+
+	for (;;) {
+		uint64_t now = mach_absolute_time(), span = now - at_prev;
+		unsigned busiest_all = 0;
+
+		at_prev = now;
+		for (unsigned d = 0; d < CPUFREQ_DOMAINS; d++) {
+			cpufreq_dom[d].busiest = 0;
+		}
+		for (unsigned cpu = 0; cpu < GOV_CPUS; cpu++) {
+			uint32_t mpidr;
+			uint64_t idle;
+
+			if (!sweet_cpu_sample(cpu, &mpidr, &idle)) {
+				continue;
+			}
+			unsigned core = (mpidr >> 8) & 0xffu;
+			unsigned d = core < 4 ? 0 : core < 7 ? 1 : 2;
+			if (have_prev[cpu] && span != 0) {
+				uint64_t idled = idle - idle_prev[cpu];
+				unsigned busy = idled >= span ? 0 : (unsigned)((span - idled) * 1000 / span);
+				if (busy > cpufreq_dom[d].busiest) {
+					cpufreq_dom[d].busiest = busy;
+				}
+				if (busy > busiest_all) {
+					busiest_all = busy;
+				}
+			}
+			idle_prev[cpu] = idle;
+			have_prev[cpu] = true;
+		}
+
+		/* each domain's level: the work x 1.5, at once up, down after GOV_DOWN_HOLD */
+		for (unsigned d = 0; d < CPUFREQ_DOMAINS; d++) {
+			struct cpufreq_domain *dom = &cpufreq_dom[d];
+			unsigned want;
+
+			if (dom->base == 0 || dom->n == 0) {
+				continue;
+			}
+			if (dom->busiest >= GOV_FULL_PERMILLE) {
+				want = dom->cap;
+			} else {
+				uint64_t khz = (uint64_t)dom->khz[dom->level] * dom->busiest * 150 / 100000;
+				want = cpufreq_level_for(dom, khz);
+			}
+			if (want >= dom->level) {
+				dom->hold = 0;
+				cpufreq_set(dom, want);
+			} else if (++dom->hold >= GOV_DOWN_HOLD) {
+				dom->hold = 0;
+				cpufreq_set(dom, want);
+			}
+			if (dom->level > dom->cap) {
+				cpufreq_set(dom, dom->cap);
+			}
+			dom->sum_khz += dom->khz[dom->level];
+			dom->sum_busy += dom->busiest;
+		}
+
+		/* the memory bus: up at once, down after a quiet second */
+		quiet = busiest_all < GOV_QUIET_PERMILLE ? quiet + 1 : 0;
+		if (!ddr_top && quiet == 0) {
+			ddr_top = sweet_rpmh_ddr_set(true) == 0 ? true : ddr_top;
+		} else if (ddr_top && quiet >= GOV_QUIET_SAMPLES) {
+			ddr_top = sweet_rpmh_ddr_set(false) == 0 ? false : ddr_top;
+		}
+		ddr_top_samples += ddr_top;
+		stat_samples++;
+
+		/* the temperature: the gold and prime domains' (and if need be silver's) highest level */
+		if (++samples % THERMAL_EVERY == 0 && limit != 0) {
+			unsigned which = 0;
+			int32_t t = tsens_hottest(&which);
+			int32_t over = t == TEMP_NONE ? TEMP_NONE : t - (int32_t)limit * 10;
+
+			for (unsigned d = 0; d < CPUFREQ_DOMAINS && over != TEMP_NONE; d++) {
+				struct cpufreq_domain *dom = &cpufreq_dom[d];
+				unsigned floor = dom->n > 4 ? dom->n / 3 : 0;   /* never under a third of the table */
+
+				if (dom->n == 0) {
+					continue;
+				}
+				if (over >= 0 && (d != 0 || over >= 50)) {
+					unsigned steps = over >= 100 ? 3 : 1;
+					dom->cap = dom->cap > floor + steps ? dom->cap - steps : floor;
+				} else if (over <= -50 && dom->cap < dom->top) {
+					dom->cap++;
+				}
+				if (dom->level > dom->cap) {
+					cpufreq_set(dom, dom->cap);
+				}
+			}
+		}
+
+		if (stats_s != 0 && now - stats_since >= stats_abs && stat_samples != 0) {
+			char line[400], temp[16], gpu[16];
+			unsigned which = 0;
+			int at = 0;
+
+			cpufreq_temp_text(temp, sizeof(temp), tsens_hottest(&which));
+			cpufreq_temp_text(gpu, sizeof(gpu), tsens_read(tsens0, TSENS_GPU));
+			for (unsigned d = 0; d < CPUFREQ_DOMAINS; d++) {
+				struct cpufreq_domain *dom = &cpufreq_dom[d];
+				if (dom->n == 0) {
+					continue;
+				}
+				at += snprintf(line + at, sizeof(line) - (size_t)at, "%s%s %llu MHz, busiest core %llu%%%s",
+				    at ? "; " : "", cpufreq_names[d], dom->sum_khz / stat_samples / 1000,
+				    dom->sum_busy / stat_samples / 10, dom->cap < dom->top ? " (hot: capped)" : "");
+				if (dom->cap < dom->top) {
+					at += snprintf(line + at, sizeof(line) - (size_t)at, " at %u MHz", dom->khz[dom->cap] / 1000);
+				}
+				dom->sum_khz = dom->sum_busy = 0;
+			}
+			printf("SWEET CPUFREQ: %u s: %s; hottest core %s (sensor %u), GPU %s; memory bus at its top %u%% of the time\n",
+			    stats_s, line, temp, which, gpu, ddr_top_samples * 100 / stat_samples);
+			stats_since = now;
+			stat_samples = ddr_top_samples = 0;
+		}
+		delay_for_interval(GOV_PERIOD_MS, NSEC_PER_MSEC);
+	}
+}
