+/* (0153) the governor's thread: see the top of this file */
+static void
+cpufreq_governor(__unused void *arg, __unused wait_result_t result)
+{
+	uint32_t limit = 75, stats_s = 10;
+	uint64_t idle_prev[GOV_CPUS] = { 0 }, at_prev = 0, period_abs, stats_abs, stats_since;
+	bool have_prev[GOV_CPUS] = { false };
+	unsigned samples = 0, quiet = 0, ddr_top_samples = 0, stat_samples = 0;
+	bool ddr_top = true;
