+/* (0153) a sensor's temperature in tenths of a degree C, or TEMP_NONE if it has none */
+static int32_t
+tsens_read(vm_offset_t tm, unsigned sensor)
+{
+	uint32_t status;
+
+	if (tm == 0) {
+		return TEMP_NONE;
+	}
+	status = cpufreq_rd(tm, TSENS_STATUS(sensor));
+	if (!(status & TSENS_VALID)) {
+		return TEMP_NONE;
+	}
+	return (int32_t)(status << 20) >> 20;      /* 12-bit signed */
+}
+
+/* (0153) the hottest core sensor (tenths of a degree C) and which; TEMP_NONE if none read */
+static int32_t
+tsens_hottest(unsigned *which)
+{
+	static const uint8_t cores[] = { 1, 2, 3, 4, 7, 8, 9, 10, 11, 12, 13, 14 };
+	int32_t hottest = TEMP_NONE;
+
+	for (unsigned i = 0; i < sizeof(cores); i++) {
+		int32_t t = tsens_read(tsens0, cores[i]);
+		if (t > hottest) {
+			hottest = t;
+			*which = cores[i];
+		}
+	}
+	return hottest;
+}
