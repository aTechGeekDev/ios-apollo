+{
+	uint32_t mode = 1, low = 0x800;
+	uint32_t level;
+	int error;
+
+	(void)PE_parse_boot_argn("sweetddr", &mode, sizeof(mode));
+	(void)PE_parse_boot_argn("sweetddrlow", &low, sizeof(low));
+	level = top ? 0x3fff : (low < 0x100 ? 0x100 : low > 0x3fff ? 0x3fff : low);
