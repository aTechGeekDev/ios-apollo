+/* (xnu 0172) submission `fence` has passed (or the core stopped: nothing will pass, nothing is waited for) */
+bool
+sweet_gpu_fence_passed(uint32_t fence)
+{
+	bool passed;
+
+	if (gGPULock == NULL || fence == 0) {
+		return true;
+	}
+	IOLockLock(gGPULock);
+	passed = gGPUStopped || sweet_gpu_done(fence);
+	IOLockUnlock(gGPULock);
+	return passed;
