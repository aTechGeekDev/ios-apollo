+/*
+ * (xnu 0172) The display's own GPU copy (sweet_gpu_blit(), SweetSurface.h), for Metal on Turnip: backboardd's frame
+ * (an IOSurface Turnip drew into) scaled by the 2D engine into a page-flip frame of the panel, in the ring behind the
+ * Turnip work that drew it, so nothing waits on the processor and nothing is copied by it (boot 114: the processor's
+ * copy took 4-7 ms a frame). The stream is Turnip's for vkCmdBlitImage of a B8G8R8A8 image (tu_clear_blit.cc
+ * r2d_setup / r2d_src / r2d_dst / r2d_run, Mesa 25), as IOS-26-Hot's xnu 0095 (flame) captured it on the A640, with
+ * the A650's values: RB_CCU_CNTL for sysmem 0x18000000 (3 CCUs, as step 22 of sweet_gpu.c), RB_DBG_ECO_CNTL needs no
+ * change around the blit (freedreno_devices.py: _blit = the value for the A650). Turnip writes all of its state again
+ * at the start of every command buffer (tu6_init_hw), so what the copy leaves set does not reach its next one.
+ *
+ * Surfaces are entered into the GPU's address space once and kept (BLIT_MAPS, the least recently used given back
+ * when its last copy has passed; one not used for BLIT_IDLE_MS given back too); the copy's command stream goes into
+ * one of BLIT_SLOTS places of a write-combining page.
+ */
+#define BLIT_MAPS               8
+#define BLIT_SLOTS              4
+#define BLIT_SLOT_BYTES         0x300u          /* a stream is 70 words */
+#define BLIT_STAMP_AT           0xe00u          /* where the events' timestamps go */
+#define BLIT_IDLE_MS            2000
+#define BLIT_RB_CCU_CNTL_SYSMEM 0x18000000u
+#define BLIT_8888_UNORM         0x10f03000u     /* RB_2D_BLIT_CNTL: FMT6_8_8_8_8_UNORM, mask 0xf, R2D_UNORM8 */
+#define BLIT_SRC_INFO           0x00500430u     /* SP_PS_2D_SRC_INFO: 8888, linear, WXYZ, UNK20, UNK22 */
+#define BLIT_DST_INFO           0x00000430u     /* RB_2D_DST_INFO: 8888, linear, WXYZ */
+#define BLIT_DST_FORMAT         0x0000f180u     /* SP_2D_DST_FORMAT: 8888, mask 0xf */
+
+struct blit_map {
+	SweetSurface *surface;                  /* held while mapped; NULL: a free entry */
+	uint64_t address, size;
+	uint32_t fence;                         /* the last copy that reads or writes it */
+	uint64_t used;                          /* mach_absolute_time() of that copy */
+	bool keep;                              /* a panel frame: never given back */
+};
+static struct blit_map gBlitMaps[BLIT_MAPS];
+static IOBufferMemoryDescriptor *gBlitMemory;
+static volatile uint32_t *gBlitWords;
+static uint64_t gBlitAddress;
+static uint32_t gBlitFence[BLIT_SLOTS], gBlitNext;
+static bool gBlitRefused;                       /* the stream's page could not be had: never again */
+
+static inline uint32_t
+blitParity(uint32_t v)
+{
+	return (0x9669u >> (0xfu & (v ^ (v >> 4) ^ (v >> 8) ^ (v >> 12) ^ (v >> 16) ^ (v >> 20) ^ (v >> 24) ^ (v >> 28)))) & 1u;
+}
+
+static inline uint32_t
+blitPkt4(uint32_t reg, uint32_t count)
+{
+	return (4u << 28) | count | (blitParity(count) << 7) | (reg << 8) | (blitParity(reg) << 27);
+}
+
+static inline uint32_t
+blitPkt7(uint32_t op, uint32_t count)
+{
+	return (7u << 28) | count | (blitParity(count) << 15) | (op << 16) | (blitParity(op) << 23);
+}
+
+/* With gGPULock held: the page for the streams, once */
+static bool
+blitSetup(void)
+{
+	IOByteCount length = 0;
+	addr64_t phys;
+
+	if (gBlitWords != NULL) {
+		return true;
+	}
+	if (gBlitRefused) {
+		return false;
+	}
+	gBlitMemory = IOBufferMemoryDescriptor::inTaskWithOptions(kernel_task,
+	    kIODirectionInOut | kIOMemoryPhysicallyContiguous | kIOMapWriteCombineCache, 4096, 4096);
+	phys = gBlitMemory != NULL ? gBlitMemory->getPhysicalSegment(0, &length, kIOMemoryMapperNone) : 0;
+	gBlitAddress = phys != 0 ? sweet_gpu_address(4096) : 0;
+	if (gBlitAddress == 0 || !sweet_gpu_map(gBlitAddress, phys, false)) {
+		if (gBlitAddress != 0) {
+			sweet_gpu_address_free(gBlitAddress, 4096);
+		}
+		OSSafeReleaseNULL(gBlitMemory);
+		gBlitRefused = true;
+		IOLog("SweetGPU: the display's GPU copy has no page for its commands: the processor copies\n");
+		return false;
+	}
+	sweet_gpu_mapped();
+	gBlitWords = (volatile uint32_t *)gBlitMemory->getBytesNoCopy();
+	for (uint32_t i = 0; i < 1024; i++) {
+		gBlitWords[i] = 0;
+	}
+	IOLog("SweetGPU: the display's GPU copy: commands at GPU address 0x%llx (xnu 0172)\n", gBlitAddress);
+	return true;
+}
+
+/*
+ * With gGPULock held: surface s's GPU address (entered and held the first time; *fresh then), 0: none could be had.
+ * Entries given back meanwhile are put in drop[] (released by the caller, after the lock).
+ */
+static uint64_t
+blitMap(SweetSurface *s, bool keep, bool *fresh, SweetSurface **drop, uint32_t *dropped)
+{
+	struct blit_map *entry = NULL, *oldest = NULL;
+	uint64_t now = mach_absolute_time(), idle, size;
+	bool mapped = true;
+
+	nanoseconds_to_absolutetime((uint64_t)BLIT_IDLE_MS * NSEC_PER_MSEC, &idle);
+	for (uint32_t i = 0; i < BLIT_MAPS; i++) {
+		struct blit_map *m = &gBlitMaps[i];
+
+		if (m->surface == s) {
+			return m->address;
+		}
+		if (m->surface != NULL && !m->keep && now - m->used >= idle && (gGPUStopped || sweet_gpu_done(m->fence))) {
+			sweet_gpu_unmap(m->address, m->size);
+			sweet_gpu_address_free(m->address, m->size);
+			drop[(*dropped)++] = m->surface;
+			m->surface = NULL;
+		}
+		if (m->surface == NULL) {
+			entry = entry != NULL ? entry : m;
+		} else if (!m->keep && (gGPUStopped || sweet_gpu_done(m->fence)) && (oldest == NULL || m->used < oldest->used)) {
+			oldest = m;
+		}
+	}
+	if (entry == NULL && oldest != NULL) {
+		sweet_gpu_unmap(oldest->address, oldest->size);
+		sweet_gpu_address_free(oldest->address, oldest->size);
+		drop[(*dropped)++] = oldest->surface;
+		oldest->surface = NULL;
+		entry = oldest;
+	}
+	if (entry == NULL || s->memory == NULL) {
+		return 0;
+	}
+	size = round_page_64(s->memory->getLength());
+	if (size == 0 || size > GPU_BUFFER_MAX || (entry->address = sweet_gpu_address(size)) == 0) {
+		return 0;
+	}
+	for (uint64_t offset = 0; offset < size && mapped; offset += 4096) {
+		IOByteCount length = 0;
+		addr64_t phys = s->memory->getPhysicalSegment(offset, &length, kIOMemoryMapperNone);
+
+		mapped = phys != 0 && sweet_gpu_map(entry->address + offset, phys, false);
+	}
+	sweet_gpu_mapped();
+	if (!mapped) {
+		sweet_gpu_unmap(entry->address, size);
+		sweet_gpu_address_free(entry->address, size);
+		IOLog("SweetGPU: the display's GPU copy cannot enter surface %u (%llu bytes)\n", s->id, size);
+		return 0;
+	}
+	s->retain();
+	entry->surface = s;
+	entry->size = size;
+	entry->fence = 0;
+	entry->used = now;
+	entry->keep = keep;
+	if (fresh != NULL) {
+		*fresh = true;
+	}
+	IOLog("SweetGPU: the display's GPU copy holds surface %u (%ux%u, rows of %u, %llu KiB) at 0x%llx%s\n", s->id,
+	    s->width, s->height, s->bytesPerRow, size >> 10, entry->address, keep ? ", a panel frame" : "");
+	return entry->address;
+}
+
+static void
+blitUsed(SweetSurface *s, uint32_t fence)
+{
+	for (uint32_t i = 0; i < BLIT_MAPS; i++) {
+		if (gBlitMaps[i].surface == s) {
+			gBlitMaps[i].fence = fence;
+			gBlitMaps[i].used = mach_absolute_time();
+		}
+	}
+}
+
+/* the stream (tu_clear_blit.cc's r2d path); returns its words */
+static uint32_t
+blitStream(volatile uint32_t *dw, const struct sweet_blit *b, uint64_t src, uint64_t dst, uint64_t stamp)
+{
+	uint32_t n = 0;
+
+#define EV(e)           do { dw[n++] = blitPkt7(0x46, 1); dw[n++] = (e); } while (0)
+#define EV_TS(e)        do { dw[n++] = blitPkt7(0x46, 4); dw[n++] = (e); dw[n++] = (uint32_t)stamp; \
+	                     dw[n++] = (uint32_t)(stamp >> 32); dw[n++] = 0; } while (0)
+#define REG(r, v)       do { dw[n++] = blitPkt4((r), 1); dw[n++] = (v); } while (0)
+#define WFI()           do { dw[n++] = blitPkt7(0x26, 0); } while (0)
+	/* tu_emit_cache_flush_ccu(SYSMEM): what the colour and depth caches hold out, both dropped, then the CCU's mode */
+	EV_TS(0x1d);                            /* PC_CCU_FLUSH_COLOR_TS */
+	EV_TS(0x1c);                            /* PC_CCU_FLUSH_DEPTH_TS */
+	EV(0x19);                               /* PC_CCU_INVALIDATE_COLOR */
+	EV(0x18);                               /* PC_CCU_INVALIDATE_DEPTH */
+	EV(0x31);                               /* CACHE_INVALIDATE: the texture cache reads Turnip's frame afresh */
+	WFI();
+	REG(0x8e07, BLIT_RB_CCU_CNTL_SYSMEM);   /* RB_CCU_CNTL */
+	dw[n++] = blitPkt7(0x65, 1);            /* CP_SET_MARKER: 2D blits follow (RM6_BLIT2DSCALE), as fd6 and step 22 */
+	dw[n++] = 12;
+	/* r2d_setup_common */
+	REG(0x8c01, 0);                         /* RB_2D_UNKNOWN_8C01 */
+	REG(0x8c00, BLIT_8888_UNORM);           /* RB_2D_BLIT_CNTL */
+	REG(0x8400, BLIT_8888_UNORM);           /* GRAS_2D_BLIT_CNTL */
+	REG(0xacc0, BLIT_DST_FORMAT);           /* SP_2D_DST_FORMAT */
+	/* the rectangles: inclusive; the source's in 24.8 */
+	dw[n++] = blitPkt4(0x8405, 2);          /* GRAS_2D_DST_TL, _BR */
+	dw[n++] = b->dx | (b->dy << 16);
+	dw[n++] = (b->dx + b->dw - 1) | ((b->dy + b->dh - 1) << 16);
+	dw[n++] = blitPkt4(0x8401, 4);          /* GRAS_2D_SRC_TL_X, _BR_X, _TL_Y, _BR_Y */
+	dw[n++] = b->sx << 8;
+	dw[n++] = (b->sx + b->sw - 1) << 8;
+	dw[n++] = b->sy << 8;
+	dw[n++] = (b->sy + b->sh - 1) << 8;
+	/* r2d_src */
+	dw[n++] = blitPkt4(0xb4c0, 5);          /* SP_PS_2D_SRC_INFO, _SIZE, the base, _PITCH */
+	dw[n++] = BLIT_SRC_INFO | (b->filter ? 0x10000u : 0);
+	dw[n++] = b->src_w | (b->src_h << 15);
+	dw[n++] = (uint32_t)src;
+	dw[n++] = (uint32_t)(src >> 32);
+	dw[n++] = b->src_row << 3;              /* PITCH: bits 9.., in 64 bytes */
+	dw[n++] = blitPkt4(0xb4ca, 3);          /* SP_PS_2D_SRC_FLAGS, _PITCH: none */
+	dw[n++] = 0;
+	dw[n++] = 0;
+	dw[n++] = 0;
+	/* r2d_dst */
+	dw[n++] = blitPkt4(0x8c17, 4);          /* RB_2D_DST_INFO, the base, _PITCH (64 bytes) */
+	dw[n++] = BLIT_DST_INFO;
+	dw[n++] = (uint32_t)dst;
+	dw[n++] = (uint32_t)(dst >> 32);
+	dw[n++] = b->dst_row >> 6;
+	dw[n++] = blitPkt4(0x8c20, 3);          /* RB_2D_DST_FLAGS, _PITCH: none */
+	dw[n++] = 0;
+	dw[n++] = 0;
+	dw[n++] = 0;
+	/* r2d_run */
+	dw[n++] = blitPkt7(0x2c, 1);            /* CP_BLIT */
+	dw[n++] = 3;                            /* BLIT_OP_SCALE */
+	/* out to memory for the panel (the submission's CACHE_FLUSH_TS and fence follow) */
+	EV_TS(0x1d);                            /* PC_CCU_FLUSH_COLOR_TS */
+	WFI();
+#undef EV
+#undef EV_TS
+#undef REG
+#undef WFI
+	return n;
+}
+
+uint32_t
+sweet_gpu_blit(const struct sweet_blit *b)
+{
+	SweetSurface *drop[2 * BLIT_MAPS];
+	uint32_t dropped = 0, fence = 0, slot, words;
+	uint64_t src = 0, dst = 0;
+	bool fresh = false;
+
+	if (gGPULock == NULL || b->src == NULL || b->dst == NULL || b->sw == 0 || b->sh == 0 || b->dw == 0 || b->dh == 0 ||
+	    (b->src_row & 63) || (b->dst_row & 63) || (b->src_offset & 63)) {
+		return 0;
+	}
+	IOLockLock(gGPULock);
+	slot = gBlitNext % BLIT_SLOTS;
+	if (gGPUStopped || !blitSetup() || (gBlitFence[slot] != 0 && !sweet_gpu_done(gBlitFence[slot]))) {
+		goto out;
+	}
+	dst = blitMap(b->dst, true, NULL, drop, &dropped);
+	src = dst != 0 ? blitMap(b->src, false, &fresh, drop, &dropped) : 0;
+	if (src == 0) {
+		goto out;
+	}
+	if (fresh) {
+		/* what this processor's cache may hold of it (e.g. its pages zeroed through the kernel's mapping) out, once */
+		uintptr_t kernel = b->src->kernelAddress();
+		if (kernel != 0) {
+			sweet_gpu_to_memory((void *)kernel, b->src->memory->getLength());
+		}
+	}
+	words = blitStream(gBlitWords + slot * (BLIT_SLOT_BYTES / 4), b, src + b->src_offset, dst,
+	    gBlitAddress + BLIT_STAMP_AT);
+	sweet_gpu_to_memory(NULL, 0);
+	{
+		uint64_t address = gBlitAddress + slot * BLIT_SLOT_BYTES;
+		fence = sweet_gpu_submit(&address, &words, 1);
+	}
+	if (fence != 0) {
+		gBlitFence[slot] = fence;
+		gBlitNext++;
+		blitUsed(b->src, fence);
+		blitUsed(b->dst, fence);
+	}
+out:
+	IOLockUnlock(gGPULock);
+	for (uint32_t i = 0; i < dropped; i++) {
+		drop[i]->release();
+	}
+	return fence;
+}
