+/*
+ * (xnu 0172) The swap's only layer, backboardd's whole display, scaled into frame `frame` by the GPU (see the top of
+ * this file); the lines above and below the picture black by the processor (writes only). Returns the copy's fence;
+ * 0: not this way (said for the first few), the processor copies.
+ */
+uint32_t
+AppleCLCD::presentBlit(const uint8_t *rec, int frame)
+{
+	uint32_t mask = get32(rec, 0x104), layer = SWEET_FB_LAYERS, fence = 0;
+	const char *why = NULL;
+	SweetSurface *s = NULL;
+
+	for (uint32_t l = 0; l < SWEET_FB_LAYERS; l++) {
+		if ((mask & (1u << l)) && get32(rec, 0x54 + 4 * l) != 0) {
+			if (layer != SWEET_FB_LAYERS) {
+				why = "more than one layer";
+			}
+			layer = l;
+		}
+	}
+	if (layer == SWEET_FB_LAYERS) {
+		why = "no layer";
+	}
+	if (why == NULL) {
+		uint32_t id = get32(rec, 0x54 + 4 * layer);
+		const uint8_t *a = rec + 0x64 + 16 * layer, *b = rec + 0xc4 + 16 * layer;
+		int32_t sx = (int32_t)get32(a, 0), sy = (int32_t)get32(a, 4);
+		int32_t dx = (int32_t)get32(b, 0), dy = (int32_t)get32(b, 4), w = (int32_t)get32(b, 8), h = (int32_t)get32(b, 12);
+
+		s = sweet_surface_copy(id);
+		if (s != NULL && (w <= 0 || h <= 0)) {
+			w = (int32_t)s->width;
+			h = (int32_t)s->height;
+		}
+		uint64_t start = s != NULL ? s->offset : 0;
+		uint32_t row = s != NULL ? s->bytesPerRow : 0, bpe = s != NULL && s->bytesPerElement ? s->bytesPerElement : 4;
+		if (s != NULL && s->planeCount > 0) {
+			start = s->planes[0].offset;
+			row = s->planes[0].bytesPerRow;
+			bpe = s->planes[0].bytesPerElement;
+		}
+		if (s == NULL || s == fSurface || s->memory == NULL) {
+			why = "not a surface of a program's";
+		} else if (sx > 0 || sy > 0 || dx != 0 || dy != 0 || w != (int32_t)fLogicalW || h != (int32_t)fLogicalH ||
+		    s->width < fLogicalW || s->height < fLogicalH) {
+			why = "not exactly the display";
+		} else if (bpe != 4 || s->elementWidth != 1 || s->elementHeight != 1) {
+			why = "not 4 bytes a pixel";
+		} else if ((row & 63) != 0 || (start & 63) != 0) {
+			why = "rows not a multiple of 64 bytes";
+		} else if (start + (uint64_t)(fLogicalH - 1) * row + (uint64_t)fLogicalW * 4 > s->memory->getLength()) {
+			why = "smaller than its rows say";
+		} else if (!fFit && (fOffX < 0 || fOffY < 0)) {
+			why = "the panel is larger than the display";
+		} else {
+			struct sweet_blit bl = {};
+
+			bl.src = s;
+			bl.src_offset = start;
+			bl.src_row = row;
+			bl.src_w = s->width;
+			bl.src_h = s->height;
+			bl.dst = fFlipSurf[frame];
+			bl.dst_row = fFlipStride;
+			if (fFit) {
+				/* (0150/0152) 24/25: panel line py shows display line (py - band) * 25/24; columns 0..1079 the whole width */
+				int32_t y0 = ((int32_t)fFitTop - fFitBand) * SWEET_FB_FIT_DEN / SWEET_FB_FIT_NUM;
+				int32_t y1 = (((int32_t)fFitEnd - fFitBand) * SWEET_FB_FIT_DEN + SWEET_FB_FIT_NUM - 1) / SWEET_FB_FIT_NUM;
+				y0 = y0 < 0 ? 0 : y0;
+				y1 = y1 > (int32_t)fLogicalH ? (int32_t)fLogicalH : y1;
+				bl.sx = 0;
+				bl.sw = fLogicalW;
+				bl.sy = (uint32_t)y0;
+				bl.sh = y1 > y0 ? (uint32_t)(y1 - y0) : 0;
+				bl.dx = 0;
+				bl.dw = fWidth;
+				bl.dy = fFitTop;
+				bl.dh = fFitEnd - fFitTop;
+				bl.filter = true;
+				/* the bands, black */
+				for (uint32_t band = 0; band < 2; band++) {
+					uint32_t from = band == 0 ? 0 : fFitEnd, to = band == 0 ? fFitTop : fHeight;
+					for (uint32_t y = from; y < to; y++) {
+						volatile uint64_t *line = (volatile uint64_t *)(fFlipVA[frame] + (uint64_t)y * fFlipStride);
+						for (uint32_t x = 0; x < fWidth / 2; x++) {
+							line[x] = 0;
+						}
+					}
+				}
+			} else {
+				/* the panel's part of the display, as it is */
+				bl.sx = (uint32_t)fOffX;
+				bl.sy = (uint32_t)fOffY;
+				bl.sw = bl.dw = fWidth;
+				bl.sh = bl.dh = fHeight;
+				bl.filter = false;
+			}
+			fence = sweet_gpu_blit(&bl);
+			if (fence == 0) {
+				why = "the GPU did not take it";
+			} else if (!fBlitSaid) {
+				fBlitSaid = true;
+				IOLog("SWEET FB: the GPU copies backboardd's frames (0172): surface %u %ux%u fmt 0x%x rows %u (+%llu), "
+				    "display lines %u..%u -> panel lines %u..%u of frame %d\n", id, s->width, s->height, s->pixelFormat,
+				    row, start, bl.sy, bl.sy + bl.sh - 1, bl.dy, bl.dy + bl.dh - 1, frame);
+			}
+		}
+		if (why != NULL && fBlitRefusalsSaid < 4 && s != NULL) {
+			IOLog("SWEET FB: (0172) surface %u %ux%u fmt 0x%x rows %u planes %u at %d,%d %dx%d: the processor copies: %s\n",
+			    id, s->width, s->height, s->pixelFormat, row, s->planeCount, dx, dy, w, h, why);
+		}
+	}
+	if (why != NULL && fBlitRefusalsSaid < 4) {
+		if (s == NULL) {
+			IOLog("SWEET FB: (0172) the processor copies: %s\n", why);
+		}
+		fBlitRefusalsSaid++;
+	}
+	OSSafeReleaseNULL(s);
+	return fence;
+}
