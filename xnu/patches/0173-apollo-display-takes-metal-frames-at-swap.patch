+/* (xnu 0173) without fLock: until the last flip has been taken (at most 50 ms); true if it had to wait */
+bool
+AppleCLCD::settleWait(void)
+{
+	uint64_t waited_us = 0;
+
+	for (;;) {
+		IOLockLock(fLock);
+		settleFlip();
+		bool settled = fFlipPending < 0;
+		IOLockUnlock(fLock);
+		if (settled || waited_us >= 50000) {
+			break;
+		}
+		IODelay(200);
+		waited_us += 200;
+	}
+	return waited_us != 0;
+}
