+/* (xnu 0148) How fast one core copies 16 MiB (far more than any cache), in MB a second; 0 if it cannot be said. */
+static uint64_t
+rh_copy_speed(void)
+{
+	const vm_size_t size = 16u << 20;
+	uint8_t *buf = kalloc_data(2 * size, Z_WAITOK);
+	uint64_t t0, ns = 0;
+
+	if (buf == NULL) {
+		return 0;
+	}
+	memset(buf, 1, 2 * size);       /* (the pages are touched before the copy is timed) */
+	t0 = mach_absolute_time();
+	memcpy(buf + size, buf, size);
+	absolutetime_to_nanoseconds(mach_absolute_time() - t0, &ns);
+	kfree_data(buf, 2 * size);
+	return ns ? (uint64_t)size * 1000 / ns : 0;
+}
