+/* (xnu 0148) The memory bus to its top (see the top of this file); nothing with boot-arg sweetddr=0. */
+void
+sweet_rpmh_ddr_top(void)
+{
+	uint32_t enabled = 1;
+	uint64_t before, after;
+	int error;
+
+	(void)PE_parse_boot_argn("sweetddr", &enabled, sizeof(enabled));
+	if (!enabled) {
+		return;
+	}
+	before = rh_copy_speed();
+	error = sweet_rpmh_bcm_vote("MC0", 0x3fff, 0x3fff);
+	if (!error) {
+		error = sweet_rpmh_bcm_vote("SH0", 0x3fff, 0x3fff);
+	}
+	if (!error) {
+		error = sweet_rpmh_bcm_vote("ACV", 0, 8);      /* (the application processor's bit) */
+	}
+	if (error) {
+		printf("SWEET RPMH: the memory bus vote failed (errno %d); a core copied %llu MB/s\n", error, before);
+		return;
+	}
+	delay(20000);
+	after = rh_copy_speed();
+	printf("SWEET RPMH: THE MEMORY BUS IS VOTED TO ITS TOP: a core copies %llu MB/s (it was %llu MB/s)\n", after, before);
+}
 #endif /* ARM64_BOARD_CONFIG_SWEET */
