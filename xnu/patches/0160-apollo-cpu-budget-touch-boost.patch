+/*
+ * (xnu 0160) A CPU budget for runaway background processes, from bsd/dev/sweet_cpufreq.c's governor every few seconds.
+ * Boots 88-91: with every service of iOS enabled, voicemail's vmd (no cellular), coreduetd, biomed, accessoryupdaterd and
+ * others each kept a core 30-100% busy for minutes on end, the display on or off: the phone hot, the cores at their
+ * temperature cap, the user interface short of processor time. Rather than switching them off (the phone is to be
+ * usable every day: tools/root-files/quiet-*.txt stay optional), a process that is not in the foreground and not one
+ * the display, sound or radios depend on, and that used more than `enter` percent of a core in each of `strikes`
+ * windows in a row, is held to `held` percent of a core from then on with XNU's own task-wide CPU limit
+ * (proc_set_task_ruse_cpu(TASK_POLICY_RESOURCE_ATTRIBUTE_THROTTLE): its threads wait when its share of each second is
+ * spent -- what posix_spawn's CPU limits and Apple's own background policies use). It keeps running and answering,
+ * only slower; a process started again (a new task) is judged afresh. One line per process held:
+ * `SWEET TAME: vmd[123] used 96% of a core for 20 s: held to 10% from now on`.
+ * Boot-args: sweettame=0 (off), sweettame_enter (35), sweettame_held (10), sweettame_strikes (4).
+ */
+#define SWEET_TAME_SLOTS        512u
+static struct {
+	uint64_t uniqueid, last;
+	uint32_t strikes, gen;
+	bool held;
+} sweet_tame_seen[SWEET_TAME_SLOTS];
+static uint32_t sweet_tame_gen;
+
+static bool
+sweet_tame_exempt(const char *name, int role)
+{
+	static const char *const never[] = {
+		"launchd", "kernel_task", "backboardd", "SpringBoard", "mediaserverd", "audiomxd", "bluetoothd", "BlueTool",
+		"wifid", "configd", "logd", "watchdogd", "runningboardd", "UserEventAgent", "securityd", "keybagd",
+	};
+
+	if (role == TASK_FOREGROUND_APPLICATION || role == TASK_GRAPHICS_SERVER) {
+		return true;
+	}
+	for (unsigned i = 0; i < sizeof(never) / sizeof(never[0]); i++) {
+		if (strncmp(name, never[i], 16) == 0) {
+			return true;
+		}
+	}
+	return false;
+}
+
+void sweet_cpu_tame(uint64_t window_abs);
+
+void
+sweet_cpu_tame(uint64_t window_abs)
+{
+	static uint32_t enabled = 2, enter = 35, held = 10, strikes = 4;
+	struct {
+		task_t task;
+		int pid;
+		uint32_t percent;
+		char name[17];
+	} hold[8];
+	unsigned holds = 0;
+	task_t task;
+
+	if (enabled == 2) {
+		enabled = 1;
+		PE_parse_boot_argn("sweettame", &enabled, sizeof(enabled));
+		PE_parse_boot_argn("sweettame_enter", &enter, sizeof(enter));
+		PE_parse_boot_argn("sweettame_held", &held, sizeof(held));
+		PE_parse_boot_argn("sweettame_strikes", &strikes, sizeof(strikes));
+		held = held < 1 ? 1 : held > 100 ? 100 : held;
+	}
+	if (!enabled || window_abs == 0) {
+		return;
+	}
+	if (++sweet_tame_gen == 0) {
+		sweet_tame_gen = 1;
+	}
+	lck_mtx_lock(&tasks_threads_lock);
+	queue_iterate(&tasks, task, task_t, tasks) {
+		if (task == kernel_task || task->active == 0) {
+			continue;
+		}
+		struct recount_times_mach times = recount_task_times(task);
+		uint64_t now = times.rtm_user + times.rtm_system;
+		uint32_t slot = (uint32_t)(task->task_uniqueid * 0x9e3779b1u) % SWEET_TAME_SLOTS, free_slot = 0xffffffffu;
+		bool found = false;
+
+		for (unsigned probe = 0; probe < 16; probe++, slot = (slot + 1) % SWEET_TAME_SLOTS) {
+			if (sweet_tame_seen[slot].gen != 0 && sweet_tame_seen[slot].uniqueid == task->task_uniqueid) {
+				found = true;
+				break;
+			}
+			if (free_slot == 0xffffffffu && (sweet_tame_seen[slot].gen == 0 ||
+			    (sweet_tame_seen[slot].gen != sweet_tame_gen && sweet_tame_seen[slot].gen != sweet_tame_gen - 1))) {
+				free_slot = slot;
+			}
+		}
+		if (!found) {
+			if (free_slot == 0xffffffffu) {
+				continue;
+			}
+			slot = free_slot;
+			sweet_tame_seen[slot].uniqueid = task->task_uniqueid;
+			sweet_tame_seen[slot].last = now;
+			sweet_tame_seen[slot].strikes = 0;
+			sweet_tame_seen[slot].held = false;
+			sweet_tame_seen[slot].gen = sweet_tame_gen;
+			continue;
+		}
+		uint32_t percent = (uint32_t)((now - sweet_tame_seen[slot].last) * 100 / window_abs);
+		sweet_tame_seen[slot].last = now;
+		sweet_tame_seen[slot].gen = sweet_tame_gen;
+		if (sweet_tame_seen[slot].held) {
+			continue;
+		}
+		sweet_tame_seen[slot].strikes = percent > enter ? sweet_tame_seen[slot].strikes + 1 : 0;
+		if (sweet_tame_seen[slot].strikes < strikes || holds == sizeof(hold) / sizeof(hold[0])) {
+			continue;
+		}
+		void *proc = get_bsdtask_info(task);
+		const char *name = proc != NULL ? proc_name_address(proc) : "?";
+		if (proc == NULL || sweet_tame_exempt(name, proc_get_effective_task_policy(task, TASK_POLICY_ROLE))) {
+			sweet_tame_seen[slot].strikes = 0;
+			continue;
+		}
+		task_reference(task);
+		hold[holds].task = task;
+		hold[holds].pid = task_pid(task);
+		hold[holds].percent = percent;
+		strlcpy(hold[holds].name, name, sizeof(hold[holds].name));
+		holds++;
+		sweet_tame_seen[slot].held = true;
+	}
+	lck_mtx_unlock(&tasks_threads_lock);
+
+	for (unsigned i = 0; i < holds; i++) {
+		uint64_t seconds_ns = 0;
+		int error = proc_set_task_ruse_cpu(hold[i].task, TASK_POLICY_RESOURCE_ATTRIBUTE_THROTTLE, (uint8_t)held, NSEC_PER_SEC,
+		    0, 1);
+		absolutetime_to_nanoseconds(window_abs * strikes, &seconds_ns);
+		printf("SWEET TAME: %s[%d] used %u%% of a core (more than %u%% for %llu s): held to %u%% from now on%s\n",
+		    hold[i].name, hold[i].pid, hold[i].percent, enter, seconds_ns / NSEC_PER_SEC, held, error ? " (REFUSED)" : "");
+		task_deallocate(hold[i].task);
+	}
+}
+#endif /* SWEET */
