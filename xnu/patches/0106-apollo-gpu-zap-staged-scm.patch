@@ -335,9 +337,11 @@
 #define CP_ME_INIT            0x48u
 #define CP_SET_SECURE_MODE    0x66u         /* the command that takes the 3D core out of secure mode */
 /* TrustZone (SCM) calls that authenticate a firmware image, convention qcom_scm-smc.c */
+#define SCM_FAST              (1ull << 31)  /* atomic: answered at once (the queries). PAS calls omit it and may yield */
 #define SCM_64                (1ull << 30)
 #define SCM_SIP               (2ull << 24)  /* a call of the SoC maker's, not an Arm standard one */
 #define SCM_CALL(svc, cmd)    (((uint64_t)(svc) << 8) | (cmd))
+#define SCM_IS_CALL_AVAILABLE SCM_CALL(6, 1) /* the no-memory query Linux asks TrustZone first */
 #define SCM_PAS_INIT_IMAGE    SCM_CALL(2, 1)
 #define SCM_PAS_MEM_SETUP     SCM_CALL(2, 2)
 #define SCM_PAS_AUTH_AND_RESET SCM_CALL(2, 5)
@@ -1621,7 +1625,55 @@
 	 * (a6xx_zap_shader_init -> qcom_mdt_load -> qcom_scm_pas_*; the GPU is PAS
 	 * image 13), then has the command processor leave secure mode. The zap
 	 * metadata (.mdt) and its one loadable segment (.b02) come from the ADT.
+	 *
+	 * Boot (sweetgpu=20, no sweetgpuzap): the first SCM call this kernel made,
+	 * a yielding PAS_SHUTDOWN (smc 0x42000206), did not return -- apollo hung,
+	 * touch and the rest with it (a live hang; a reboot clears it). HackiOS
+	 * asks TrustZone a harmless question first (step 11: is the no-memory
+	 * "is-call-available" query available, the atomic call Linux makes first),
+	 * which was skipped here. So the SMCs are staged behind sweetgpuzap, the
+	 * way the touch driver stages its accesses:
+	 *   0 (default)  do nothing: step 20 is a no-op, no SCM call, no risk
+	 *   1            only the atomic, no-memory queries (safe): does TrustZone
+	 *                answer this kernel the way it answers Linux?
+	 *   2            the full zap load (the yielding PAS calls, one of which
+	 *                hung) and CP_SET_SECURE_MODE
 	 */
+	unsigned zap_stage = 0;
+	(void)PE_parse_boot_argn("sweetgpuzap", &zap_stage, sizeof(zap_stage));
+	if (zap_stage == 0) {
+		printf("SWEET GPU: step 20: held back (sweetgpuzap=0): a plain TrustZone PAS call hung apollo. "
+		    "sweetgpuzap=1 probes TrustZone safely; =2 attempts the zap shader\n");
+		goto collapse;
+	}
+	/* stage 1+: the atomic, no-memory query Linux asks first (qcom_scm __qcom_scm_is_call_available) */
+	{
+		uint64_t how = SCM_FAST | SCM_64 | SCM_SIP, ans = 0;
+		printf("SWEET GPU: step 20: ask TrustZone what Linux asks first: is \"is-call-available\" available (64-bit)?\n");
+		if (gpu_scm("whether it can be asked (64-bit)", how | SCM_IS_CALL_AVAILABLE, SCM_ONE_VALUE,
+		    SCM_SIP | SCM_IS_CALL_AVAILABLE, 0, 0, &ans) != 0 || ans != 1) {
+			how = SCM_FAST | SCM_SIP;        /* Linux's second try: 32-bit arguments */
+			ans = 0;
+			printf("SWEET GPU: step 20: the same, the 32-bit way\n");
+			if (gpu_scm("whether it can be asked (32-bit)", how | SCM_IS_CALL_AVAILABLE, SCM_ONE_VALUE,
+			    SCM_SIP | SCM_IS_CALL_AVAILABLE, 0, 0, &ans) != 0 || ans != 1) {
+				printf("SWEET GPU: step 20: TrustZone does not answer the way it answers Linux\n");
+				goto collapse;
+			}
+		}
+		ans = 0;
+		(void)gpu_scm("for the signature call", how | SCM_IS_CALL_AVAILABLE, SCM_ONE_VALUE,
+		    SCM_SIP | SCM_PAS_INIT_IMAGE, 0, 0, &ans);
+		ans = 0;
+		(void)gpu_scm("for the authenticate-and-reset call", how | SCM_IS_CALL_AVAILABLE, SCM_ONE_VALUE,
+		    SCM_SIP | SCM_PAS_AUTH_AND_RESET, 0, 0, &ans);
+		printf("SWEET GPU: step 20: TrustZone answers this kernel's queries\n");
+	}
+	if (zap_stage < 2) {
+		printf("SWEET GPU: step 20: stopping after the safe probe (sweetgpuzap=1); =2 to attempt the zap shader\n");
+		goto collapse;
+	}
+
 	const uint8_t *zap_mdt = NULL, *zap_seg = NULL;
 	unsigned int zap_mdt_size = 0, zap_seg_size = 0;
