+/*
+ * Wrap (10) and unwrap (11) a key (xnu 0134). securityd gives every keychain item a key of its
+ * own and has it wrapped by the key of the item's protection class before it stores the item,
+ * unwrapped to read it again; refused (kIOReturnUnsupported), the keychain keeps nothing -- a
+ * Wi-Fi password among it, so wifid asked for it again at every join (boot 58). With no Secure
+ * Enclave there is nothing secret to wrap with: as in HackiOS's iokit/Kernel/MiniAppleKeyStore.cpp
+ * (github.com/oosexgang/hackios-xnu-kernel, APSL 2.0), the "wrapped" key is a mark, the class and
+ * the key mixed with a fixed pattern, 8 bytes longer than the key as AES key wrap (RFC 3394) is,
+ * which is what callers make room for. It protects nothing (this key store has no passcode and is
+ * never locked anyway), and it is the same from boot to boot, so what was stored can be read back.
+ * In: scalars {handle, class}, the key (wrap) or the wrapped key (unwrap); out: the class (wrap),
+ * the result.
+ */
+static const uint8_t sweet_aks_wrap_mark[4] = { 'S', 'W', 'w', 'r' };
+
+static void
+sweet_aks_wrap_mix(uint8_t *bytes, uint32_t len)
+{
+	for (uint32_t i = 0; i < len; i++) {
+		bytes[i] = (uint8_t)(bytes[i] ^ (uint8_t)(0x5a + 37 * i));
+	}
+}
+
+static IOReturn
+sweet_aks_wrap(IOExternalMethodArguments *args, bool wrap, uint32_t in_struct)
+{
+	uint8_t in[8 + 64], out[8 + 64];
+
+	if (in_struct == 0 || in_struct > sizeof(in)) {
+		return kIOReturnBadArgument;
+	}
+	if (args->structureInputDescriptor != NULL) {
+		if (args->structureInputDescriptor->readBytes(0, in, in_struct) != in_struct) {
+			return kIOReturnBadArgument;
+		}
+	} else if (args->structureInput != NULL) {
+		memcpy(in, args->structureInput, in_struct);
+	} else {
+		return kIOReturnBadArgument;
+	}
+	if (wrap) {
+		if (in_struct > 64 || args->scalarInputCount < 2) {
+			return kIOReturnBadArgument;
+		}
+		memcpy(out, sweet_aks_wrap_mark, sizeof(sweet_aks_wrap_mark));
+		out[4] = (uint8_t)args->scalarInput[1];
+		out[5] = out[6] = out[7] = 0;
+		memcpy(out + 8, in, in_struct);
+		sweet_aks_wrap_mix(out + 8, in_struct);
+		if (args->scalarOutputCount >= 1) {
+			args->scalarOutput[0] = args->scalarInput[1];
+			args->scalarOutputCount = 1;
+		}
+		return sweet_aks_struct_out(args, out, 8 + in_struct);
+	}
+	if (in_struct <= 8 || memcmp(in, sweet_aks_wrap_mark, sizeof(sweet_aks_wrap_mark)) != 0) {
+		return kIOReturnBadArgument;
+	}
+	memcpy(out, in + 8, in_struct - 8);
+	sweet_aks_wrap_mix(out, in_struct - 8);
+	args->scalarOutputCount = 0;
+	return sweet_aks_struct_out(args, out, in_struct - 8);
+}
