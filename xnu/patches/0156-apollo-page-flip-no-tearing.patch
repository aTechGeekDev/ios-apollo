+/* (xnu 0156) one of the swap's layers fills the whole presented display: the frame can be drawn into an empty buffer */
+bool
+AppleCLCD::coversDisplay(const uint8_t *rec)
+{
+	uint32_t mask = get32(rec, 0x104);
+
+	for (uint32_t layer = 0; layer < SWEET_FB_LAYERS; layer++) {
+		const uint8_t *b = rec + 0xc4 + 16 * layer;
+		int32_t dx = (int32_t)get32(b, 0), dy = (int32_t)get32(b, 4), w = (int32_t)get32(b, 8), h = (int32_t)get32(b, 12);
+
+		if (!(mask & (1u << layer)) || get32(rec, 0x54 + 4 * layer) == 0) {
+			continue;
+		}
+		if (dx <= 0 && dy <= 0 && dx + w >= (int32_t)fLogicalW && dy + h >= (int32_t)fLogicalH) {
+			return true;
+		}
+	}
+	return false;
+}
