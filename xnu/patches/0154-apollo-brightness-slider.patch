+/*
+ * (xnu 0154) iOS's brightness: CoreBrightness sets AppleARMBacklight's "brightness" (0..255, perceived; the
+ * register as level_for() has it) with a "FadePeriod" (ms here). 0 is dark (iOS's own fade before the display
+ * goes off): the light goes out but the level a power-on gives back stays the last one that was not 0. While
+ * the display is off only that level is kept.
+ */
+void
+apollo_backlight_brightness(uint32_t value, uint32_t ms)
+{
+	if (!ready) {
+		return;
+	}
+	if (value > 255) {
+		value = 255;
+	}
+	lck_mtx_lock(&apollo_backlight_state_lock);
+	if (value != 0) {
+		on_level = level_for(value * 0x10000 / 255);
+	}
+	if (display_on) {
+		fade_start(value != 0 ? on_level : 0, ms > 5000 ? 5000 : ms);
+	}
+	lck_mtx_unlock(&apollo_backlight_state_lock);
+}
+
+/* (0154) the brightness a power-on gives back, as iOS's 0..255 (the inverse of level_for()); 128 before the WLED is known */
+uint32_t
+apollo_backlight_value(void)
+{
+	uint32_t value;
+
+	if (!ready) {
+		return 128;
+	}
+	lck_mtx_lock(&apollo_backlight_state_lock);
+	value = isqrt((uint64_t)on_level * 255 * 255 / maximum);
+	lck_mtx_unlock(&apollo_backlight_state_lock);
+	return value > 255 ? 255 : value;
+}
