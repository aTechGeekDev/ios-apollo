+/* (xnu 0154) the backlight CoreBrightness drives: see the top of this file */
+class AppleARMBacklight : public IOService {
+	OSDeclareDefaultStructors(AppleARMBacklight);
+
+	uint32_t fLogged;
+
+public:
+	void publish(uint32_t value);
+	IOReturn setProperties(OSObject *properties) APPLE_KEXT_OVERRIDE;
+};
+
+OSDefineMetaClassAndStructors(AppleARMBacklight, IOService);
+
+void
+AppleARMBacklight::publish(uint32_t value)
+{
+	OSDictionary *brightness = OSDictionary::withCapacity(3);
+	OSDictionary *parameters = OSDictionary::withCapacity(1);
+	OSNumber *min = OSNumber::withNumber(0ULL, 32), *max = OSNumber::withNumber(255ULL, 32);
+	OSNumber *now = OSNumber::withNumber(value, 32);
+
+	if (brightness != NULL && parameters != NULL && min != NULL && max != NULL && now != NULL) {
+		brightness->setObject("min", min);
+		brightness->setObject("max", max);
+		brightness->setObject("value", now);
+		parameters->setObject("brightness", brightness);
+		setProperty("IODisplayParameters", parameters);
+	}
+	OSSafeReleaseNULL(min);
+	OSSafeReleaseNULL(max);
+	OSSafeReleaseNULL(now);
+	OSSafeReleaseNULL(brightness);
+	OSSafeReleaseNULL(parameters);
+}
+
+IOReturn
+AppleARMBacklight::setProperties(OSObject *properties)
+{
+	OSDictionary *d = OSDynamicCast(OSDictionary, properties);
+	if (d == NULL) {
+		return kIOReturnBadArgument;
+	}
+	OSNumber *b = OSDynamicCast(OSNumber, d->getObject("brightness"));
+	OSNumber *f = OSDynamicCast(OSNumber, d->getObject("FadePeriod"));
+	if (b == NULL) {
+		return kIOReturnSuccess;
+	}
+	int32_t v = (int32_t)b->unsigned32BitValue();
+	uint32_t value = v < 0 ? 0 : v > 255 ? 255 : (uint32_t)v;
+	uint32_t ms = f != NULL ? (uint32_t)(((uint64_t)f->unsigned32BitValue() * 1000) >> 16) : 0;
+	if (fLogged < 30) {
+		char name[32];
+		fLogged++;
+		proc_selfname(name, sizeof(name));
+		IOLog("SWEET BL: %s sets brightness %u (fade %u ms)\n", name, value, ms);
+	}
+	apollo_backlight_brightness(value, ms);
+	publish(value);
+	return kIOReturnSuccess;
+}
