+/*
+ * (xnu 0175) And how busy the core is: each submission's start and end on the always-on counter (sweet_gpu_stamps(),
+ * 19.2 MHz, written by the ring around its command buffers), the done ones read every look; the time the core spent
+ * on them (overlaps counted once) and the longest one, said every 10 s while there is work.
+ */
+#define GPU_STAMP_SLOTS         96u             /* = KEPT_STAMPS of sweet_gpu.c */
+extern "C" bool sweet_gpu_stamps(uint32_t fence, uint64_t *start, uint64_t *end);
+static uint32_t gStampNext;
+static uint64_t gStampEnd, gStampBusy, gStampLongest, gStampSubmissions, gStampLost;
+
+/* with gGPULock held: the done submissions since the last look counted */
+static void
+gpuStampsCount(uint32_t last)
+{
+	if (gStampNext == 0) {
+		gStampNext = last + 1;
+		return;
+	}
+	while (gStampNext != last + 1 && gStampNext != 0 && sweet_gpu_done(gStampNext)) {
+		uint64_t start, end;
+
+		if (last - gStampNext >= GPU_STAMP_SLOTS) {
+			gStampLost += last - gStampNext - GPU_STAMP_SLOTS + 1;
+			gStampNext = last - GPU_STAMP_SLOTS + 1;
+			continue;
+		}
+		if (sweet_gpu_stamps(gStampNext, &start, &end) && end >= start) {
+			uint64_t from = start > gStampEnd ? start : gStampEnd;
+			if (end > from) {
+				gStampBusy += end - from;
+			}
+			if (end > gStampEnd) {
+				gStampEnd = end;
+			}
+			if (end - start > gStampLongest) {
+				gStampLongest = end - start;
+			}
+			gStampSubmissions++;
+		} else {
+			gStampLost++;
+		}
+		gStampNext++;
+	}
+}
 
