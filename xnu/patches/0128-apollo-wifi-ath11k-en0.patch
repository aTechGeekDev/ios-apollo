+/*
+ * The radio's own address. Its firmware has none: Android hands it the phone's from its storage.
+ * Boot-arg sweetwifimac=aa:bb:cc:dd:ee:ff gives it; without one a random, locally administered
+ * one is made, the same for the whole boot. The log says which way, not the address.
+ */
+bool
+sweet_wifi_radio_address(uint8_t *address)
+{
+	static uint8_t made[6];
+	static bool have;
+	if (!have) {
+		char text[32] = "";
+		bool given = PE_parse_boot_arg_str("sweetwifimac", text, sizeof(text)) && text[0] != 0, good = given;
+		unsigned count = 0, digits = 0, value = 0;
+		for (const char *c = text; good; c++) {
+			int digit = *c >= '0' && *c <= '9' ? *c - '0' : *c >= 'a' && *c <= 'f' ? *c - 'a' + 10 :
+			    *c >= 'A' && *c <= 'F' ? *c - 'A' + 10 : -1;
+			if (digit >= 0 && digits < 2) {
+				value = value << 4 | (unsigned)digit;
+				digits++;
+			} else if ((*c == ':' || *c == 0) && digits != 0 && count < 6) {
+				made[count++] = (uint8_t)value;
+				digits = value = 0;
+			} else {
+				good = false;
+			}
+			if (*c == 0) {
+				break;
+			}
+		}
+		good = good && count == 6 && !(made[0] & 1) && (made[0] | made[1] | made[2] | made[3] | made[4] | made[5]) != 0;
+		if (!good) {
+			read_random(made, sizeof(made));
+			made[0] = (uint8_t)((made[0] & 0xfe) | 0x02);   /* one station's, locally administered */
+		}
+		have = true;
+		printf("SWEET WIFI: the radio's address: %s\n", good ? "sweetwifimac, as given" : given ?
+		    "SWEETWIFIMAC IS NOT AN ADDRESS: a random one for this boot" : "a random one for this boot (no sweetwifimac)");
+	}
+	memcpy(address, made, sizeof(made));
+	return true;
+}
