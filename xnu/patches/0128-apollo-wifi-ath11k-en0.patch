+/*
+ * The kernel's side of the Wi-Fi driver's object (hakios.lx.h): what Linux's ath11k, built on
+ * FreeBSD's LinuxKPI and wifi/lx by tools/mk-ath11k.sh and linked into the kernel (xnu 0128),
+ * asks of it -- memory, time, threads, one lock to sleep under, the kernel's options -- and what it
+ * asks of the radio, which sweet_wifi.c knows: its files, its view of memory, its boot.
+ *
+ * From HackiOS's bsd/dev/hakios.lx.c (github.com/oosexgang/hackios-xnu-kernel) as the Xiaomi Mi 10
+ * (umi) port has it (github.com/JopangJovan/hackios-xnu-kernel-umi; APSL 2.0). The radio's
+ * interrupts are not used (as on the Mi 10: wifi_irq=0, the rings are polled), so the vectors are
+ * never attached; the MSI address and data are still given, the firmware wants them.
+ *
+ * A kernel built without the object has the weak lx_start() at the end of this file, which says so.
+ */
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+#include <kern/clock.h>
+#include <kern/kalloc.h>
+#include <kern/locks.h>
+#include <kern/sched_prim.h>
+#include <kern/thread.h>
+#include <libkern/libkern.h>
+#include <mach/mach_types.h>
+#include <mach/vm_param.h>
+#include <pexpert/pexpert.h>
+#include <sys/errno.h>
+#include <sys/random.h>
+#include <sys/systm.h>
+#include "hakios.lx.h"
+#include "hakios.net.h"
+#include "hakios.say.h"
+
+extern kern_return_t thread_terminate(thread_t thread);
+extern void thread_set_thread_name(thread_t thread, const char *name);
+extern void read_random(void *buffer, u_int numBytes);
+/* sweet_wifi.c */
+extern unsigned sweet_wifi_option(const char *name);
+extern const uint8_t *sweet_wifi_file(const char *name, unsigned int *size);
+extern void *sweet_wifi_radio_memory(size_t size, unsigned long long *address);
+extern void *sweet_wifi_firmware_memory(unsigned type, size_t size, unsigned long long *address);
+extern void *sweet_wifi_registers(unsigned long long physical, size_t size);
+extern bool sweet_wifi_msi(unsigned long long *address, unsigned *data);
+extern int sweet_wifi_radio_boot(void);
+extern void sweet_wifi_radio_reset(void);
+extern bool sweet_wifi_radio_address(uint8_t *address);
+extern bool sweet_wifi_network(uint8_t *name, unsigned *name_length, uint8_t *passphrase, unsigned *passphrase_length);
+void hakios_lx_net_early(void);
+int hakios_lx_start(void);
+void hakios_lx_stop(void);
+int hakios_lx_prepare(void);
+
+static LCK_GRP_DECLARE(lx_lock_group, "sweet-lx");
+static LCK_MTX_DECLARE(lx_lock, &lx_lock_group);
+
+/* ---- memory ------------------------------------------------------------------------------------------ */
+
