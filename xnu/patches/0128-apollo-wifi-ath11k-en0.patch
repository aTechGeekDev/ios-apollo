+/* With the driver: MHI's rings looked at every millisecond, for the QMI replies and indications it waits for. */
+static void
+wifi_poll_thread(void *arg, wait_result_t wr)
+{
+	(void)arg;
+	(void)wr;
+	while (__atomic_load_n(&wifi_polling, __ATOMIC_ACQUIRE)) {
+		int error = qr_poll(&qr.port, 1);
+		if (error && error != EINVAL && error != EBUSY) {
+			printf("SWEET WIFI: looking at MHI's rings failed: errno %d; they are no longer looked at\n", error);
+			break;
+		}
+		struct timespec pause = { .tv_sec = 0, .tv_nsec = 1000000 };
+		(void)msleep(&wifi_polling, NULL, PZERO, "sweetwifimhi", &pause);
+	}
+	__atomic_store_n(&wifi_poll_done, true, __ATOMIC_RELEASE);
+	(void)thread_terminate(current_thread());
+}
+
+static void
+wifi_poll_stop(void)
+{
+	__atomic_store_n(&wifi_polling, false, __ATOMIC_RELEASE);
+	wakeup(&wifi_polling);
+	while (!__atomic_load_n(&wifi_poll_done, __ATOMIC_ACQUIRE)) {
+		delay(1000);
+	}
+}
+
+/*
+ * Steps 11 and 12: Linux's ath11k (sweet_lx.c) on the running firmware, through the same QRTR.
+ * It does its own handshake -- calibration, then a restart of the radio (sweet_wifi_radio_reset,
+ * sweet_wifi_radio_boot) -- and then scans and goes down (11), or offers the station to iOS and
+ * stays (12).
+ */
+static int
+wifi_driver(unsigned steps)
+{
+	thread_t thread;
+	hakios_qmi_set_transport(&qr_ops);
+	__atomic_store_n(&wifi_poll_done, false, __ATOMIC_RELAXED);
+	__atomic_store_n(&wifi_polling, true, __ATOMIC_RELEASE);
+	if (kernel_thread_start(wifi_poll_thread, NULL, &thread) != KERN_SUCCESS) {
+		__atomic_store_n(&wifi_polling, false, __ATOMIC_RELEASE);
+		__atomic_store_n(&wifi_poll_done, true, __ATOMIC_RELEASE);
+		hakios_qmi_set_transport(NULL);
+		printf("SWEET WIFI: step %u: no thread to look at MHI's rings\n", steps);
+		return EAGAIN;
+	}
+	thread_set_thread_name(thread, "sweet-wifi-mhi");
+	thread_deallocate(thread);
+	printf("SWEET WIFI: step %u: Linux's ath11k takes the radio: its handshake, then %s\n", steps,
+	    steps == 11 ? "a scan, then down again" : "en0 for iOS");
+	int error = hakios_lx_start();
+	if (!error && steps == 12) {
+		wifi_keep = true;
+		printf("SWEET WIFI: step 12: THE DRIVER IS UP: en0 is the radio's; wifid scans and joins through it\n");
+		return 0;
+	}
+	printf("SWEET WIFI: step %u: the driver: errno %d%s\n", steps, error,
+	    error ? "" : ": IT CAME UP AND SCANNED (the networks are above)");
+	hakios_lx_stop();
+	wifi_poll_stop();
+	hakios_qmi_set_transport(NULL);
+	return error;
+}
