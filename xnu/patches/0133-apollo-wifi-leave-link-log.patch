--- a/bsd/dev/sweet_apple80211.c
+++ b/bsd/dev/sweet_apple80211.c
@@ -798,7 +798,15 @@
 errno_t
 hakios_apple80211_ioctl(u_long command, void *data)
 {
-	static unsigned said;
+	/*
+	 * (xnu 0133) Said: each kind of request (its number, get or set) its first 12 times; scans, joins,
+	 * leaves, power and the join's result (10, 19, 20, 21, 22) up to 600 times in all; a kind's answer
+	 * when it differs from the last one said. One count for all of them (800 lines) used to run out
+	 * before the first join (boot 57: nothing said after the ASSOCIATE).
+	 */
+	static uint16_t said[512][2];
+	static int said_error[512][2];
+	static unsigned said_important;
