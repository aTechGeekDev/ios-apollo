+/*
+ * (xnu 0174) The GPU's watchdog. A hung core was noticed only by a program waiting a second or more for a fence
+ * (gpuWait): Turnip's clients wait in short steps, and boot 115 froze in Settings with no "no answer" in the log
+ * (backboardd sent no frame again; whether the GPU had hung is not known). Every 500 ms: the last submission there is
+ * becomes the one watched; if the one watched has not passed 5 s later (no frame of iOS's takes that long), what the
+ * core says is logged and it is recovered as 0163 does (every fence before then reads as passed, so waiters go on).
+ * Boot-arg sweetgpudog=0: off; =N: N seconds.
+ */
+#define GPU_DOG_LOOK_MS         500
+
+static void
+gpuWatchdog(__unused void *arg, __unused wait_result_t result)
+{
+	uint32_t watched = 0, seconds = 5, recoveries = 0;
+	uint64_t since = 0, patience;
+
+	PE_parse_boot_argn("sweetgpudog", &seconds, sizeof(seconds));
+	if (seconds == 0) {
+		IOLog("SweetGPU: watchdog off (sweetgpudog=0)\n");
+		return;
+	}
+	nanoseconds_to_absolutetime((uint64_t)seconds * NSEC_PER_SEC, &patience);
+	IOLog("SweetGPU: watchdog on: a submission not done after %u s resets the core (xnu 0174)\n", seconds);
+	for (;;) {
+		IOSleep(GPU_DOG_LOOK_MS);
+		IOLockLock(gGPULock);
+		uint32_t last = sweet_gpu_last();
+		if (gGPUStopped || last == 0) {
+			watched = 0;
+		} else if (watched == 0 || sweet_gpu_done(watched)) {
+			/* the one watched passed (or none was): the newest not yet done is watched now */
+			watched = sweet_gpu_done(last) ? 0 : last;
+			since = mach_absolute_time();
+		} else if (mach_absolute_time() - since >= patience) {
+			IOLog("SweetGPU: watchdog: submission %u not done after %u s (the last is %u; Turnip's last %u): the "
+			    "core is reset (%u so far)\n", watched, seconds, last, gV2LastFence, ++recoveries);
+			sweet_gpu_report("watchdog");
+			gGPUStopped = !sweet_gpu_recover();     /* (0163) */
+			IOLog("SweetGPU: watchdog: %s\n", gGPUStopped ? "the core did not come back: the GPU is stopped" :
+			    "the core is back");
+			watched = 0;
+		}
+		IOLockUnlock(gGPULock);
+	}
+}
