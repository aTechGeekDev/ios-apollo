+/*
+ * sweet_files.c - files the boot image carries, written onto the root before launchd starts.
+ *
+ * tools/mkadt.py --file /usr/local/lib/NAME=LOCAL puts a file into the device tree as
+ * /sweet-files "fileN" = path, NUL, contents. bsdinit_task() calls sweet_files_install()
+ * right before it loads launchd: the root is mounted (read-write with boot-arg rootrw=1)
+ * and nothing has the files open yet. Each one is written whole (created, or truncated
+ * and written), mode 0755 (0644 outside /usr/local/), owner root; the boot after keeps it, with or without it in
+ * the device tree. So a new build of the CoreAnimation bridge or of Mesa goes onto the
+ * phone with a new boot image, and the root and what iOS has written into it (its first
+ * boot, settings) stay as they are.
+ *
+ * Only paths under /usr/local/ (our libraries) and /Library/Wallpaper/ (the stock wallpapers'
+ * layers as PNG: tools/wallpaper-files.py) are taken. Boot-arg sweetfiles=0: none are written.
+ */
+#include <pexpert/arm64/board_config.h>
+
+#if defined(ARM64_BOARD_CONFIG_SWEET)
+
+#include <sys/param.h>
+#include <sys/systm.h>
+#include <sys/errno.h>
+#include <sys/fcntl.h>
+#include <sys/vnode.h>
+#include <sys/uio.h>
+#include <sys/proc.h>
+#include <pexpert/pexpert.h>
+#include <pexpert/device_tree.h>
+
+void sweet_files_install(void);
+
+static const char *const sweet_files_prefixes[] = { "/usr/local/", "/Library/Wallpaper/" };
+
+/* (the kernel has no strstr: a ".." component, looked for by hand) */
+static bool
+sweet_file_allowed(const char *path)
+{
+	for (const char *p = path; *p != '\0'; p++) {
+		if (p[0] == '/' && p[1] == '.' && p[2] == '.' && (p[3] == '/' || p[3] == '\0')) {
+			return false;
+		}
+	}
+	for (size_t i = 0; i < sizeof(sweet_files_prefixes) / sizeof(sweet_files_prefixes[0]); i++) {
+		if (strncmp(path, sweet_files_prefixes[i], strlen(sweet_files_prefixes[i])) == 0) {
+			return true;
+		}
+	}
+	return false;
+}
+
+static int
+sweet_file_write(const char *path, const uint8_t *data, size_t size)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	vnode_t vp = NULLVP;
+	int error;
+
+	error = vnode_open(path, O_CREAT | O_TRUNC | FWRITE | O_NOFOLLOW, strncmp(path, "/usr/local/", 11) == 0 ? 0755 : 0644, 0,
+	    &vp, ctx);
+	if (error != 0) {
+		return error;
+	}
+	/* in pieces: vn_rdwr takes an int length */
+	for (size_t done = 0; done < size && error == 0;) {
+		size_t chunk = size - done > (1u << 20) ? (1u << 20) : size - done;
+		int resid = 0;
+
+		error = vn_rdwr(UIO_WRITE, vp, (caddr_t)(uintptr_t)(data + done), (int)chunk, (off_t)done,
+		    UIO_SYSSPACE, IO_NOAUTH | IO_SYNC, vfs_context_ucred(ctx), &resid, vfs_context_proc(ctx));
+		if (error == 0 && resid != 0) {
+			error = EIO;
+		}
+		done += chunk;
+	}
+	vnode_close(vp, FWRITE, ctx);
+	return error;
+}
+
+void
+sweet_files_install(void)
+{
+	uint32_t enabled = 1;
+	DTEntry node;
+
+	(void)PE_parse_boot_argn("sweetfiles", &enabled, sizeof(enabled));
+	if (!enabled || SecureDTLookupEntry(NULL, "/sweet-files", &node) != kSuccess) {
+		return;
+	}
+	for (unsigned i = 0; i < 64; i++) {
+		char name[16];
+		const void *prop = NULL;
+		unsigned int size = 0;
+
+		snprintf(name, sizeof(name), "file%u", i);
+		if (SecureDTGetProperty(node, name, &prop, &size) != kSuccess) {
+			break;
+		}
+		const char *path = prop;
+		size_t len = strnlen(path, size < 1024 ? size : 1024);
+		if (len == 0 || len >= size || len >= 1024 || !sweet_file_allowed(path)) {
+			printf("SWEET FILES: %s: not a path that may be written; not written\n", name);
+			continue;
+		}
+		const uint8_t *data = (const uint8_t *)prop + len + 1;
+		size_t bytes = size - len - 1;
+		int error = sweet_file_write(path, data, bytes);
+		printf("SWEET FILES: %s: %zu bytes %s (error %d)\n", path, bytes, error == 0 ? "written" : "NOT written", error);
+	}
+}
+
+#endif /* ARM64_BOARD_CONFIG_SWEET */
