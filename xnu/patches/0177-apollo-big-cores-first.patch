+/* (xnu 0177) the little cores for the scheduler; said when `say` */
+extern uint64_t sweet_little_cpus;              /* osfmk/kern/sched_prim.c */
+extern int sweet_fast_pri;
+
+static void
+cpufreq_cpu_kinds(bool say)
+{
+	unsigned bigfirst = 1, cpus = 0;
+	uint64_t little = 0;
+
+	(void)PE_parse_boot_argn("sweetbigfirst", &bigfirst, sizeof(bigfirst));
+	for (unsigned cpu = 0; cpu < GOV_CPUS; cpu++) {
+		uint32_t mpidr;
+		uint64_t idle;
+
+		if (!sweet_cpu_sample(cpu, &mpidr, &idle)) {
+			continue;
+		}
+		cpus++;
+		if (((mpidr >> 8) & 0xffu) < 4) {
+			little |= 1ull << cpu;
+		}
+	}
+	if (bigfirst == 0) {
+		sweet_fast_pri = 128;   /* above MAXPRI: no thread starts on the big cores first */
+	} else if (little != 0 && cpus > (unsigned)__builtin_popcountll(little)) {
+		sweet_little_cpus = little;
+	}
+	if (say) {
+		printf("SWEET CPUFREQ: %u CPUs up, the Cortex-A55s at CPU mask %#llx: %s (xnu 0177)\n", cpus,
+		    (unsigned long long)little, bigfirst == 0 ? "XNU's own CPU order (sweetbigfirst=0)" :
+		    "threads at priority 31 and up, and realtime ones, start on the fastest idle big core");
+	}
+}
