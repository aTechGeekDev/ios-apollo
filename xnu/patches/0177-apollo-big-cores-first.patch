+/*
+ * (xnu 0177) apollo's cores are not alike, and this kernel treats them as if they were (one SMP processor set): its
+ * cores 0-3 are Cortex-A55s at 1.8 GHz, 4-6 Cortex-A77s at 2.4 GHz and 7 a Cortex-A77 at 2.84 GHz (boot-arg cpumask=0xf1:
+ * logical CPU 0 is core 0, an A55, then the A77s in order). XNU's choices all go to the lowest-numbered CPU first: an
+ * idle CPU for a thread that wakes (lsb_first), and for a realtime one the lowest CPU not already running realtime
+ * work, idle or not. So CoreAnimation's threads (backboardd's display thread at 30-60 % of a core, its realtime render
+ * server) and an app's main thread kept landing on the A55, where a frame takes about twice as long: stutters.
+ * Here a thread at sweet_fast_pri (BASEPRI_DEFAULT, 31) or above, or a realtime one, takes the fastest idle core first
+ * (the highest-numbered big one, the prime core first), and leaves a hint to an idle little core while a big core is
+ * idle; a thread under it (utility, background) takes the little core first, then the slowest big one. Little cores:
+ * sweet_little_cpus, set by bsd/dev/sweet_cpufreq.c from each CPU's MPIDR (0: none known yet: every CPU counts as big).
+ * Boot-arg sweetbigfirst=0 (read there): XNU's own order.
+ */
+extern uint64_t sweet_little_cpus;             /* (also bsd/dev/sweet_cpufreq.c) */
+extern int sweet_fast_pri;
+uint64_t sweet_little_cpus;
+int sweet_fast_pri = BASEPRI_DEFAULT;
+
+static inline bool
+sweet_big_first(int pri)
+{
+	return pri >= sweet_fast_pri;
+}
+
+/* the CPU of `map` a thread of priority `pri` should take first (-1: none) */
+static inline int
+sweet_pick_cpu(cpumap_t map, int pri)
+{
+	cpumap_t big = map & ~sweet_little_cpus, little = map & sweet_little_cpus;
+
+	if (sweet_big_first(pri)) {
+		return big != 0 ? bit_first(big) : lsb_first(map);
+	}
+	return little != 0 ? lsb_first(little) : lsb_first(map);
+}
