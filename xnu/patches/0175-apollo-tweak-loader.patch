--- a/bsd/kern/kern_exec.c
+++ b/bsd/kern/kern_exec.c
@@ -5592,6 +5592,36 @@
 /* (xnu 0164) + the Files app, its daemon and the "On My iPhone" provider: their os_log mirrored (libsweet-fix); (0166) + usermanagerd; (0168) + configd, which starts the jailbreak installer */
 #define SWEET_INJECT_BUILTIN    "/usr/local/lib/libsweet-fix.dylib:ScreenshotServicesService,fileproviderd,Files,LocalStorageFileProvider,usermanagerd,configd"
 
+/*
+ * (xnu 0175) apollo_tweaks=1 (a boot-arg or mkadt.py --option apollo_tweaks=1; apollo_option(), bsd/dev/apollo_pmic.c):
+ * SpringBoard and the apps (/Applications, the installed apps' bundles) that no group above names get the rootless
+ * jailbreak's tweak loader, which ElleKit installs (Sileo: the ElleKit package). Only when that file is there: dyld
+ * ends a program whose inserted library is missing. Daemons get nothing: a broken tweak can only take apps and the
+ * home screen down, and the boot image's option turns it off again.
+ */
+extern int apollo_option(const char *name, int fallback);
+#define SWEET_TWEAK_LOADER      "/var/jb/usr/lib/TweakLoader.dylib"
+
+static bool
+sweet_exec_tweaks(const char *path, char *env, size_t size)
+{
+	static const char *const apps[] = { "/Applications/", "/private/var/containers/Bundle/Application/",
+		                            "/var/containers/Bundle/Application/" };
+	bool want = strcmp(path, "/System/Library/CoreServices/SpringBoard.app/SpringBoard") == 0;
+	vnode_t vp = NULLVP;
+
+	for (size_t i = 0; !want && i < sizeof(apps) / sizeof(apps[0]); i++) {
+		want = strncmp(path, apps[i], strlen(apps[i])) == 0;
+	}
+	if (!want || apollo_option("apollo_tweaks", 0) < 1 ||
+	    vnode_lookup(SWEET_TWEAK_LOADER, 0, &vp, vfs_context_kernel()) != 0) {
+		return false;
+	}
+	vnode_put(vp);
+	snprintf(env, size, "DYLD_INSERT_LIBRARIES=" SWEET_TWEAK_LOADER);
+	return true;
+}
+
 static bool
 sweet_exec_inject(struct image_params *imgp, char *env, size_t size)
 {
@@ -5642,7 +5672,7 @@
 		}
 		group += grouplen + (group[grouplen] == ';');
 	}
-	return false;
+	return sweet_exec_tweaks(path, env, size);
 }
