+#if defined(ARM64_BOARD_CONFIG_SWEET)
+/*
+ * (project-BadApple xnu 0135) Where Safari's processes connect, and how that goes: on apollo
+ * Safari shows no pages while Spotlight's web results come (boots 58-59), and WebKit's processes
+ * all start with none crashing. The first 96 connects of MobileSafari and com.apple.WebKit.*:
+ * an address and port, or a local socket's path, and the error (36: in progress, as usual).
+ */
+static void
+sweet_connect_said(struct socket *so, struct sockaddr *sa, int error)
+{
+	static uint32_t said;
+	char name[32];
+	const char *kind;
+
+	if (sa == NULL || said >= 96) {
+		return;
+	}
+	proc_selfname(name, sizeof(name));
+	if (strncmp(name, "com.apple.WebKit", 16) != 0 && strcmp(name, "MobileSafari") != 0) {
+		return;
+	}
+	said++;
+	kind = so->so_type == SOCK_STREAM ? "tcp" : so->so_type == SOCK_DGRAM ? "udp" : "other";
+	if (sa->sa_family == AF_INET && sa->sa_len >= sizeof(struct sockaddr_in)) {
+		struct sockaddr_in in;
+		uint32_t a;
+
+		memcpy(&in, sa, sizeof(in));
+		a = ntohl(in.sin_addr.s_addr);
+		printf("net: %s connects to %u.%u.%u.%u port %u (%s): %d\n", name, a >> 24, (a >> 16) & 0xff, (a >> 8) & 0xff,
+		    a & 0xff, (unsigned)ntohs(in.sin_port), kind, error);
+	} else if (sa->sa_family == AF_INET6 && sa->sa_len >= sizeof(struct sockaddr_in6)) {
+		struct sockaddr_in6 in6;
+		unsigned g[8];
+
+		memcpy(&in6, sa, sizeof(in6));
+		for (unsigned i = 0; i < 8; i++) {
+			g[i] = (unsigned)in6.sin6_addr.s6_addr[2 * i] << 8 | in6.sin6_addr.s6_addr[2 * i + 1];
+		}
+		printf("net: %s connects to [%x:%x:%x:%x:%x:%x:%x:%x] port %u (%s): %d\n", name, g[0], g[1], g[2], g[3], g[4],
+		    g[5], g[6], g[7], (unsigned)ntohs(in6.sin6_port), kind, error);
+	} else if (sa->sa_family == AF_UNIX) {
+		char path[64];
+		size_t length = sa->sa_len > 2 ? (size_t)sa->sa_len - 2 : 0;
+
+		if (length > sizeof(path) - 1) {
+			length = sizeof(path) - 1;
+		}
+		memcpy(path, (const char *)sa + 2, length);     /* (sockaddr_un: length, family, the path) */
+		path[length] = '\0';
+		printf("net: %s connects to the local socket %s: %d\n", name, path, error);
+	} else {
+		printf("net: %s connects to an address of family %u: %d\n", name, (unsigned)sa->sa_family, error);
+	}
+}
+#endif /* ARM64_BOARD_CONFIG_SWEET */
