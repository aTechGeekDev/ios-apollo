 /*
- * The NVM file (TLV type 2) made to keep the UART at 115200 baud: tag 17 (the HCI transport) has
- * the baud rate in its byte 1 on the QCA6390 (byte 2 on the older ROME). Every record is checked
- * before anything is changed. 0, or -1 if the file is not what it should be.
+ * The UART speeds this knows (xnu 0145): the QCA set-baudrate/NVM index (Linux's enum qca_baudrate)
+ * and how SE6 makes it -- its root clock from GPLL0's even output (300 MHz) x m / n, an M/N/D
+ * counter, as Linux's gcc-kona QUP table, and the GENI divider: root = 16 x baud x div.
+ */
+struct sweet_bt_speed {
+	uint32_t baud;
+	uint8_t qca;
+	uint16_t m, n;
+	uint8_t div;
+};
+
+static const struct sweet_bt_speed sweet_bt_speeds[] = {
+	{ 115200, 0, 384, 15625, 4 },   /* 7.3728 MHz, the speed the chip's ROM starts at */
+	{ 230400, 5, 384, 15625, 2 },
+	{ 460800, 7, 384, 15625, 1 },
+	{ 921600, 10, 768, 15625, 1 },  /* 14.7456 MHz */
+	{ 1000000, 11, 4, 75, 1 },      /* 16 MHz */
+	{ 2000000, 13, 8, 75, 1 },      /* 32 MHz */
+	{ 3000000, 14, 4, 25, 1 },      /* 48 MHz */
+	{ 3200000, 17, 64, 375, 1 },    /* 51.2 MHz, Linux's operating speed for the QCA6390 */
+};
+
+/* The entry for `baud`, or NULL. */
+static inline const struct sweet_bt_speed *
+sweet_bt_speed_for(uint32_t baud)
+{
+	for (size_t i = 0; i < sizeof(sweet_bt_speeds) / sizeof(sweet_bt_speeds[0]); i++) {
+		if (sweet_bt_speeds[i].baud == baud) {
+			return &sweet_bt_speeds[i];
+		}
+	}
+	return NULL;
+}
