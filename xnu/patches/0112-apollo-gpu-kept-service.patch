+	gGPULock = IOLockAlloc();
+	gpu = OSTypeAlloc(SweetGPU);
+	if (gGPULock == NULL || gpu == NULL || provider == NULL || !gpu->init() || !gpu->attach(provider)) {
+		OSSafeReleaseNULL(gpu);
