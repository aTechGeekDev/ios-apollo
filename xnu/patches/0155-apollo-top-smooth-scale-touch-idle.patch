+/* (xnu 0155) p..q by w of 256, each channel; two channels at a time in 16-bit lanes (0xff * 256 fits) */
+static inline uint32_t
+sweet_mix(uint32_t p, uint32_t q, uint32_t w)
+{
+	uint32_t v = 256 - w;
+	uint32_t rb = (((p & 0x00ff00ffu) * v + (q & 0x00ff00ffu) * w) >> 8) & 0x00ff00ffu;
+	uint32_t ag = (((p >> 8) & 0x00ff00ffu) * v + ((q >> 8) & 0x00ff00ffu) * w) & 0xff00ff00u;
+	return rb | ag;
+}
+
+/* the same for two pixels at once */
+static inline uint64_t
+sweet_mix2(uint64_t p, uint64_t q, uint64_t w)
+{
+	const uint64_t m = 0x00ff00ff00ff00ffull;
+	uint64_t v = 256 - w;
+	uint64_t rb = (((p & m) * v + (q & m) * w) >> 8) & m;
+	uint64_t ag = (((p >> 8) & m) * v + ((q >> 8) & m) * w) & ~m;
+	return rb | ag;
+}
