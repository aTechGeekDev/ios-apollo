+/* (xnu 0155) a write tried up to three times: the arbiter drops one now and then (boot 86: "the transfer was dropped") */
+static const char *
+spmi_write(const struct peripheral *p, uint8_t reg, const uint8_t *bytes, uint32_t count)
+{
+	const char *problem = NULL;
+
+	for (unsigned attempt = 0; attempt < 3; attempt++) {
+		if ((problem = spmi_write_once(p, reg, bytes, count)) == NULL) {
+			break;
+		}
+		delay(50);
+	}
+	return problem;
