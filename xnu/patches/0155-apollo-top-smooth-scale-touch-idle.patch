+AppleCLCD::presentSmooth(uint64_t base, uint64_t row, int32_t sx, int32_t w, int32_t dy, int32_t h,
+    uint32_t px0, uint32_t px1, uint32_t py0, uint32_t py1)
+{
+	uint32_t n = px1 - px0;
+	if (n == 0) {
+		return;
+	}
+	/* the source columns the panel's take: fXMap[0] .. fXMap[n - 1] + 1 (at most the layer's last), from an even one */
+	uint32_t c0 = fXMap[0] & ~1u, c1 = fXMap[n - 1] + 1;
+	if (c1 > (uint32_t)(sx + w - 1)) {
+		c1 = (uint32_t)(sx + w - 1);
+	}
+	for (uint32_t py = py0; py < py1; py++) {
+		int32_t at = ((int32_t)py - fFitBand) * SWEET_FB_FIT_DEN;
+		int32_t ys = at / SWEET_FB_FIT_NUM - dy;
+		uint32_t fraction = (uint32_t)(at % SWEET_FB_FIT_NUM);
+		int32_t ya = ys < 0 ? 0 : ys >= h ? h - 1 : ys;
+		int32_t yb = ya + 1 < h ? ya + 1 : ya;
+		uint32_t wy = yb == ya ? 0 : fraction * 256 / SWEET_FB_FIT_NUM;
+		const uint32_t *a = (const uint32_t *)(base + (uint64_t)ya * row);
+		const uint32_t *line = a;
+
+		if (wy != 0) {
+			const uint32_t *b = (const uint32_t *)(base + (uint64_t)yb * row);
+			uint32_t c = c0;
+			for (; c + 1 <= c1; c += 2) {
+				uint64_t pa, pb;
+				memcpy(&pa, a + c, 8);
+				memcpy(&pb, b + c, 8);
+				uint64_t mixed = sweet_mix2(pa, pb, wy);
+				memcpy(fLine + c, &mixed, 8);
+			}
+			if (c == c1) {          /* an odd one at the end: never a read past the layer's last column */
+				fLine[c] = sweet_mix(a[c], b[c], wy);
+			}
+			line = fLine;
+		}
+		uint32_t *to = (uint32_t *)(fPixels + (uint64_t)py * fRowBytes) + px0;
