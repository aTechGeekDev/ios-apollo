+/*
+ * (xnu 0155) A "top" for sweet_cpufreq.c: the threads that ran most since the last call, with their process and
+ * thread names and the share of one core each had, into `out` (one line). Every thread's run time
+ * (recount_thread_time_mach: user + system) is remembered by thread id in a small table from one call to the
+ * next; a thread first seen counts with its whole run time. The idle threads are left out. Unnamed kernel
+ * threads show the event they were waiting on, unslid (a static variable of their driver: tools/sweet-symbolicate.sh
+ * or nm on the kernel names it). Called every few seconds from one thread; walks the thread list under
+ * tasks_threads_lock (as processor_info's callers do).
+ */
+#define SWEET_TOP_SLOTS         4096u
+#define SWEET_TOP_SHOWN         8u
+static struct {
+	uint64_t tid, last;
+	uint32_t gen;
+} sweet_top_seen[SWEET_TOP_SLOTS];
+static uint32_t sweet_top_gen;
+
+void sweet_cpu_top(char *out, size_t size, uint64_t window_abs);
+
+void
+sweet_cpu_top(char *out, size_t size, uint64_t window_abs)
+{
+	struct {
+		uint64_t delta;
+		char who[56];
+	} best[SWEET_TOP_SHOWN];
+	thread_t thread;
+	unsigned threads_seen = 0;
+	int at = 0;
+
+	bzero(best, sizeof(best));
+	if (++sweet_top_gen == 0) {
+		sweet_top_gen = 1;
+	}
+	lck_mtx_lock(&tasks_threads_lock);
+	queue_iterate(&threads, thread, thread_t, threads) {
+		bool idle = (thread->state & TH_IDLE) != 0;
+		uint64_t now, delta = 0;
+		uint32_t slot = (uint32_t)(thread->thread_id * 0x9e3779b1u) % SWEET_TOP_SLOTS, free_slot = 0xffffffffu;
+		bool found = false;
+
+		for (unsigned i = 0; i < topology_info.num_cpus && !idle; i++) {
+			idle = processor_array[i] != PROCESSOR_NULL && processor_array[i]->idle_thread == thread;
+		}
+		if (idle) {
+			continue;
+		}
+		threads_seen++;
+		now = recount_thread_time_mach(thread);
+		for (unsigned probe = 0; probe < 16; probe++, slot = (slot + 1) % SWEET_TOP_SLOTS) {
+			if (sweet_top_seen[slot].gen != 0 && sweet_top_seen[slot].tid == thread->thread_id) {
+				found = true;
+				break;
+			}
+			/* free: never used, or not seen in this call nor the last (its thread has gone) */
+			if (free_slot == 0xffffffffu && (sweet_top_seen[slot].gen == 0 ||
+			    (sweet_top_seen[slot].gen != sweet_top_gen && sweet_top_seen[slot].gen != sweet_top_gen - 1))) {
+				free_slot = slot;
+			}
+		}
+		if (found) {
+			delta = now - sweet_top_seen[slot].last;
+		} else if (sweet_top_gen > 1) {
+			delta = now;
+		}
+		if (!found && free_slot != 0xffffffffu) {
+			slot = free_slot;
+			found = true;
+			sweet_top_seen[slot].tid = thread->thread_id;
+		}
+		if (found) {
+			sweet_top_seen[slot].last = now;
+			sweet_top_seen[slot].gen = sweet_top_gen;
+		}
+
+		/* into the list of the busiest, in order */
+		unsigned place = SWEET_TOP_SHOWN;
+		while (place > 0 && delta > best[place - 1].delta) {
+			place--;
+		}
+		if (place == SWEET_TOP_SHOWN || delta == 0) {
+			continue;
+		}
+		memmove(&best[place + 1], &best[place], sizeof(best[0]) * (SWEET_TOP_SHOWN - 1 - place));
+		best[place].delta = delta;
+
+		task_t task = get_threadtask(thread);
+		void *proc = task != TASK_NULL ? get_bsdtask_info(task) : NULL;
+		const char *pname = proc != NULL ? proc_name_address(proc) : "?";
+		char tname[MAXTHREADNAMESIZE];
+		tname[0] = '\0';
+		thread_get_thread_name(thread, tname);
+		tname[MAXTHREADNAMESIZE - 1] = '\0';
+		if (tname[0] != '\0') {
+			snprintf(best[place].who, sizeof(best[place].who), "%s/%s", pname, tname);
+		} else if (task == kernel_task && thread->wait_event != 0) {
+			snprintf(best[place].who, sizeof(best[place].who), "%s/ev %#lx", pname,
+			    (unsigned long)VM_KERNEL_UNSLIDE((vm_offset_t)thread->wait_event));
+		} else {
+			snprintf(best[place].who, sizeof(best[place].who), "%s/#%llu", pname, thread->thread_id);
+		}
+	}
+	lck_mtx_unlock(&tasks_threads_lock);
+
+	at = snprintf(out, size, "%u threads;", threads_seen);
+	for (unsigned i = 0; i < SWEET_TOP_SHOWN && best[i].delta != 0 && at > 0 && (size_t)at < size; i++) {
+		at += snprintf(out + at, size - (size_t)at, " %s %llu%%", best[i].who,
+		    window_abs != 0 ? best[i].delta * 100 / window_abs : 0);
+	}
+}
