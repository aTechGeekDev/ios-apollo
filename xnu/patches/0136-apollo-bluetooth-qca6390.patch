+ * Wi-Fi: ACTIVE votes held until reset, nothing switched off.
+ */
+int
+sweet_rpmh_bt_power(void)
+{
+	static const struct { const char *resource; unsigned mv; } rails[] = {
+		{ "smpa6", 950 },       /* PM8150 S6: AON and digital */
+		{ "smpa5", 1900 },      /* PM8150 S5: RFA1 */
+		{ "smpc8", 1350 },      /* PM8150A S8: RFA2 */
+		{ "ldoa16", 3025 },     /* PM8150 L16: ASD, the lowest of the DT's 3.024-3.3 V */
+	};
+	uint32_t addresses[sizeof(rails) / sizeof(rails[0])];
+	if (__atomic_exchange_n(&rh_lock, 1, __ATOMIC_ACQUIRE)) {
+		return EBUSY;
+	}
+	int error = EIO;
+	if (rh_poisoned) {
+		printf("SWEET RPMH: previous uncertain transaction; refusing further access\n");
+		goto out;
+	}
+	error = rh_map();
+	for (unsigned i = 0; !error && i < sizeof(rails) / sizeof(rails[0]); ++i) {
+		error = rh_lookup(rails[i].resource, &addresses[i]);
+	}
+	for (unsigned i = 0; !error && i < sizeof(rails) / sizeof(rails[0]); ++i) {
+		printf("SWEET RPMH: Bluetooth %s at least %u mV\n", rails[i].resource, rails[i].mv);
+		error = rh_send(addresses[i], rails[i].mv, false);
+	}
+out:
+	if (error) {
+		printf("SWEET RPMH: Bluetooth rails failed errno=%d\n", error);
+	}
+	__atomic_store_n(&rh_lock, 0, __ATOMIC_RELEASE);
+	return error;
 }
