+/*
+ * Bluetooth H4 framing and the QCA6390's firmware records, for sweet_bt.c (xnu 0136).
+ *
+ * From the Xiaomi Mi 10 port of github.com/JopangJovan/hackios-xnu-kernel-umi,
+ * devices/xiaomi-mi-10/overlays/xnu/files/bsd/sys/hakios.bluetooth.h (MIT). Between whole H4
+ * packets the chip also sends single bytes of its in-band sleep protocol (IBS): 0xfd "wake",
+ * 0xfe "sleep", 0xfc "awake, acknowledged".
+ */
+#ifndef SWEET_BT_H
+#define SWEET_BT_H
+#include <stdint.h>
+#include <stddef.h>
+
+#define SWEET_BT_H4_MAX 4096u
+
+struct sweet_bt_h4 {
+	uint8_t bytes[SWEET_BT_H4_MAX];
+	uint32_t used, wanted, header;
+	int complete;
+};
+
+/*
+ * One more byte of an H4 stream: 0 not yet a packet, 1 a packet is complete (bytes[0..used)), 2 an
+ * IBS byte, -1 a byte that begins no packet type, -2 a packet longer than SWEET_BT_H4_MAX. After
+ * -1 or -2 the stream is out of step and the caller starts over.
+ */
+static inline int
+sweet_bt_h4_push(struct sweet_bt_h4 *p, uint8_t byte)
+{
+	if (p->complete) {
+		p->used = p->wanted = p->header = 0;
+		p->complete = 0;
+	}
+	if (p->used == 0) {
+		if (byte >= 0xfc && byte <= 0xfe) {
+			return 2;
+		}
+		switch (byte) {
+		case 1:                 /* command: type, opcode (2), length (1) */
+		case 3:                 /* SCO data: type, handle (2), length (1) */
+			p->header = 4;
+			break;
+		case 2:                 /* ACL data: type, handle (2), length (2) */
+		case 5:                 /* ISO data: type, handle (2), length (2, 14 bits) */
+			p->header = 5;
+			break;
+		case 4:                 /* event: type, code, length (1) */
+			p->header = 3;
+			break;
+		default:
+			return -1;
+		}
+		p->wanted = p->header;
+	}
+	if (p->used >= SWEET_BT_H4_MAX) {
+		return -2;
+	}
+	p->bytes[p->used++] = byte;
+	if (p->used == p->header) {
+		uint32_t length;
+
+		switch (p->bytes[0]) {
+		case 1:
+		case 3:
+			length = p->bytes[3];
+			break;
+		case 4:
+			length = p->bytes[2];
+			break;
+		default:
+			length = p->bytes[3] | (uint32_t)p->bytes[4] << 8;
+			if (p->bytes[0] == 5) {
+				length &= 0x3fff;
+			}
+			break;
+		}
+		if (length > SWEET_BT_H4_MAX - p->header) {
+			p->used = p->wanted = p->header = 0;
+			return -2;
+		}
+		p->wanted = p->header + length;
+	}
+	if (p->used == p->wanted) {
+		p->complete = 1;
+		return 1;
+	}
+	return 0;
+}
+
+/* The status of an HCI Command Complete event for `opcode`, or -1 if `e` is not one. */
+static inline int
+sweet_bt_cc_status(const uint8_t *e, size_t n, uint16_t opcode)
+{
+	if (n < 7 || e[0] != 4 || e[1] != 0x0e || (size_t)e[2] + 3 != n ||
+	    e[4] != (uint8_t)opcode || e[5] != (uint8_t)(opcode >> 8)) {
+		return -1;
+	}
+	return e[6];
+}
+
+/* Whether `e` acknowledges a firmware record segment (0xfc00, EDL patch request 0x1e). */
+static inline int
+sweet_bt_qca_tlv_ack(const uint8_t *e, size_t n)
+{
+	/* the QCA6390 ("Hastings") answers with Command Complete, its sub-opcode included */
+	return (n == 8 && sweet_bt_cc_status(e, n, 0xfc00) == 0 && e[7] == 0x1e) ||
+	       (n == 6 && e[0] == 4 && e[1] == 0xff && e[2] == 3 && e[3] == 0 && e[4] == 4 && e[5] == 0);
+}
+
+/*
+ * The NVM file (TLV type 2) made to keep the UART at 115200 baud: tag 17 (the HCI transport) has
+ * the baud rate in its byte 1 on the QCA6390 (byte 2 on the older ROME). Every record is checked
+ * before anything is changed. 0, or -1 if the file is not what it should be.
+ */
+static inline int
+sweet_bt_qca6390_nvm_prepare(uint8_t *data, size_t n)
+{
+	size_t hci = 0;
+
+	if (n < 4 || data[0] != 2 ||
+	    ((uint32_t)data[1] | (uint32_t)data[2] << 8 | (uint32_t)data[3] << 16) != n - 4) {
+		return -1;
+	}
+	for (size_t off = 4; off < n;) {
+		unsigned id, len;
+
+		if (n - off < 12) {
+			return -1;
+		}
+		id = data[off] | (unsigned)data[off + 1] << 8;
+		len = data[off + 2] | (unsigned)data[off + 3] << 8;
+		if (len > n - off - 12) {
+			return -1;
+		}
+		if (id == 17) {
+			if (len < 3 || hci) {
+				return -1;
+			}
+			hci = off + 12;
+		}
+		off += 12 + len;
+	}
+	if (!hci) {
+		return -1;
+	}
+	data[hci + 1] = 0;              /* QCA_BAUDRATE_115200 */
+	return 0;
+}
+#endif /* SWEET_BT_H */
