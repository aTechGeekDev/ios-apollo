 /*
  * sweet_files.c - files the boot image carries, written onto the root before launchd starts.
  *
- * tools/mkadt.py --file /usr/local/lib/NAME=LOCAL puts a file into the device tree as
- * /sweet-files "fileN" = path, NUL, contents. bsdinit_task() calls sweet_files_install()
- * right before it loads launchd: the root is mounted (read-write with boot-arg rootrw=1)
- * and nothing has the files open yet. Each one is written whole (created, or truncated
- * and written), mode 0755 (0644 outside /usr/local/), owner root; the boot after keeps it, with or without it in
- * the device tree. So a new build of the CoreAnimation bridge or of Mesa goes onto the
- * phone with a new boot image, and the root and what iOS has written into it (its first
- * boot, settings) stay as they are.
+ * tools/mkadt.py --file DEST=LOCAL / --files-from LIST put them into the device tree node
+ * /sweet-files: "fileN" = path, NUL, contents; "ownerN" (if there) = uid, gid, mode (three
+ * 32-bit words) for fileN; "deleteN" = a path to remove. bsdinit_task() calls
+ * sweet_files_install() right before it loads launchd: the root is mounted (read-write with
+ * boot-arg rootrw=1) and nothing has the files open yet. The removals go first; then each
+ * file is written whole (created, or truncated and written), owner and mode as ownerN says,
+ * else root and 0755 under /usr/local/, 0644 elsewhere; folders missing on the way are made
+ * with the file's owner, mode 0755 (vfs_syscalls.c sweet_kernel_mkdir). The boot after keeps
+ * it all, with or without it in the device tree. So a new build of the CoreAnimation bridge,
+ * Mesa, a setting or a wallpaper goes onto the phone with a new boot image, and the root and
+ * what iOS has written into it (its first boot, settings) stay as they are.
  *
- * Only paths under /usr/local/ (our libraries), /Library/Wallpaper/ (the stock wallpapers'
- * layers as PNG: tools/wallpaper-files.py) and /private/var/preferences/FeatureFlags/ (feature
- * flag overrides: tools/root-files/) are taken. Folders missing on the way are made (0755,
- * owner root; vfs_syscalls.c sweet_kernel_mkdir). Boot-arg sweetfiles=0: none are written.
+ * Any absolute path without a ".." component is taken (mkadt.py keeps the list of where
+ * files may go). Boot-arg sweetfiles=0: nothing is written or removed.
  */
