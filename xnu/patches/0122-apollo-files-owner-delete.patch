+/* An absolute path with no ".." component (the kernel has no strstr: looked for by hand). */
 static bool
 sweet_file_allowed(const char *path)
 {
+	if (path[0] != '/') {
+		return false;
+	}
 	for (const char *p = path; *p != '\0'; p++) {
 		if (p[0] == '/' && p[1] == '.' && p[2] == '.' && (p[3] == '/' || p[3] == '\0')) {
 			return false;
 		}
 	}
-	for (size_t i = 0; i < sizeof(sweet_files_prefixes) / sizeof(sweet_files_prefixes[0]); i++) {
-		if (strncmp(path, sweet_files_prefixes[i], strlen(sweet_files_prefixes[i])) == 0) {
-			return true;
+	return true;
+}
+
+static int
+sweet_file_own(const char *path, vnode_t vp, const struct sweet_owner *owner)
+{
+	vfs_context_t ctx = vfs_context_kernel();
+	struct vnode_attr va;
+	bool looked_up = false;
+	int error;
+
+	if (vp == NULLVP) {
+		if ((error = vnode_lookup(path, 0, &vp, ctx)) != 0) {
+			return error;
 		}
+		looked_up = true;
+	}
+	VATTR_INIT(&va);
+	VATTR_SET(&va, va_uid, owner->uid);
+	VATTR_SET(&va, va_gid, owner->gid);
+	VATTR_SET(&va, va_mode, owner->mode & ALLPERMS);
+	error = vnode_setattr(vp, &va, ctx);
+	if (looked_up) {
+		vnode_put(vp);
 	}
-	return false;
+	return error;
 }
 
