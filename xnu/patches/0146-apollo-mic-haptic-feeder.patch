+int
+sweet_rpmh_bcm_vote(const char *name, uint32_t ab, uint32_t ib)
+{
+	static const uint32_t offsets[1] = {0};
+	uint32_t values[1] = {RH_BCM_VOTE(ab, ib)};
+	uint32_t address = 0;
+	char what[48];
+	if (!name || !rh_take()) {
