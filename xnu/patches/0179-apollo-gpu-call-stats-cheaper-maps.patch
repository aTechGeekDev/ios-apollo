+/*
+ * (xnu 0179) What Turnip's clients ask of the kernel and how long it takes there: per method the calls, the time inside
+ * the kernel and the longest one (mach time), said every 10 s by SweetGPU.cpp's watchdog thread (sweet_accelerator_stats)
+ * and then reset. A buffer made, mapped or given back on CoreAnimation's thread is time out of a frame; WaitFence is
+ * time a client's thread waited for the GPU.
+ */
+#define V2_STAT_METHODS         17
+static volatile SInt64 gV2Calls[V2_STAT_METHODS], gV2Abs[V2_STAT_METHODS], gV2Most[V2_STAT_METHODS];
+static const char *const gV2Names[V2_STAT_METHODS] = {
+	"?", "Query", "BoAlloc", "BoMap", "BoFree", "Submit", "WaitFence", "Timestamp", "Status", "SetMeta", "GetMeta",
+	"Queue", "CloseQueue", "CpuMap", "CpuUnmap", "DeviceInfo", "BoImport",
+};
+
+extern "C" size_t sweet_accelerator_stats(char *out, size_t size);
+
+/* the line's text (methods called in the window), the counts reset; 0: none was called */
+size_t
+sweet_accelerator_stats(char *out, size_t size)
+{
+	size_t at = 0;
+
+	out[0] = 0;
+	for (uint32_t m = 1; m < V2_STAT_METHODS; m++) {
+		SInt64 calls = gV2Calls[m], abs = gV2Abs[m], most = gV2Most[m];
+		uint64_t ns = 0, most_ns = 0;
+
+		if (calls == 0) {
+			continue;
+		}
+		OSAddAtomic64(-calls, &gV2Calls[m]);
+		OSAddAtomic64(-abs, &gV2Abs[m]);
+		gV2Most[m] = 0;
+		absolutetime_to_nanoseconds((uint64_t)abs, &ns);
+		absolutetime_to_nanoseconds((uint64_t)most, &most_ns);
+		if (at < size) {
+			int n = snprintf(out + at, size - at, "%s%s %lld x %llu.%llu ms (most %llu.%llu)", at ? ", " : "", gV2Names[m],
+			    calls, ns / NSEC_PER_MSEC, ns % NSEC_PER_MSEC / 100000, most_ns / NSEC_PER_MSEC,
+			    most_ns % NSEC_PER_MSEC / 100000);
+			at = n > 0 ? at + (size_t)n : at;
+		}
+	}
+	return at < size ? at : size - 1;
+}
