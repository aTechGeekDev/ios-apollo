+/*
+ * For the firmware's own memory (sweet_wlfw.c): `size` zeroed bytes behind the fixed IOVA stock
+ * CNSS gives them, above everything handed out so far. The firmware uses them, the CPU does not
+ * read them back: cached pages, pushed out once here (sweet_wifi_clean after the CPU writes).
+ */
+void *
+sweet_wifi_memory_at(size_t size, uint64_t iova)
+{
+	vm_offset_t memory = 0;
+	size = round_page(size);
+	if (size == 0 || iova < RADIO_IOVA + rs.next || (iova & 4095) || iova + size > RADIO_IOVA + RADIO_IOVA_SIZE) {
+		printf("SWEET WIFI: no %zu bytes at IOVA %#llx (handed out up to %#llx)\n", size, iova, RADIO_IOVA + rs.next);
+		return NULL;
+	}
+	if (kmem_alloc(kernel_map, &memory, size, KMA_KOBJECT | KMA_ZERO | KMA_DATA, VM_KERN_MEMORY_IOKIT) != KERN_SUCCESS) {
+		printf("SWEET WIFI: no %zu bytes for the firmware\n", size);
+		return NULL;
+	}
+	sweet_wifi_clean((void *)memory, size);
+	rs.next = iova - RADIO_IOVA;
+	uint64_t at = 0;
+	if (!radio_map(0, memory, size, RADIO_PTE, &at) || at != iova) {
+		return NULL;
+	}
+	return (void *)memory;
+}
+
+void
+sweet_wifi_clean(const void *memory, size_t size)
+{
+	for (vm_offset_t line = (vm_offset_t)memory & ~(vm_offset_t)63; line < (vm_offset_t)memory + size; line += 64) {
+		__asm__ volatile ("dc civac, %0" : : "r" (line));
+	}
+	__asm__ volatile ("dsb sy" ::: "memory");
+}
