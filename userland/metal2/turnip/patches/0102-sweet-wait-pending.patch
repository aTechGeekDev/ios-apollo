+/*
+ * sweet (ios-apollo): until the sync is a submission or signaled -- what VK_SYNC_WAIT_PENDING means. The runtime
+ * (vk_queue.c) uses that wait to tell whether a submission's dependencies have reached the kernel yet: a zero-timeout
+ * one decides whether the queue needs its submit thread, and the thread waits with it before it calls the driver.
+ * UniXNU's sync answered every pending wait at once, so a wait on a sync not yet submitted could reach
+ * darwin_queue_submit, which then waited for it with submit_mutex -- already held by its caller (tu queue_submit):
+ * the submitting thread locked itself for good (boots 121/123: backboardd's Metal device lost now and then; 115: the
+ * display thread stuck in a system call). Never with submit_mutex held.
+ */
+static VkResult
+darwin_sync_until_submitted(struct tu_device *device, struct vk_darwin_sync *s, uint64_t abs_timeout_ns)
+{
+   if (s->state != DARWIN_SYNC_UNSIGNALED)
+      return VK_SUCCESS;
+   if (abs_timeout_ns == 0)
+      return VK_TIMEOUT;
+
+   pthread_mutex_lock(&device->submit_mutex);
+   /* os_time_get_nano() is monotonic but Darwin condition variables wait on the realtime clock. */
+   struct timespec abstime;
+   {
+      uint64_t now = os_time_get_nano();
+      uint64_t relative = abs_timeout_ns > now ? abs_timeout_ns - now : 0;
+      clock_gettime(CLOCK_REALTIME, &abstime);
+      uint64_t nsec = (uint64_t)abstime.tv_nsec + relative % 1000000000ull;
+      abstime.tv_sec += relative / 1000000000ull + nsec / 1000000000ull;
+      abstime.tv_nsec = nsec % 1000000000ull;
+   }
+   while (s->state == DARWIN_SYNC_UNSIGNALED) {
+      int ret;
+      if (abs_timeout_ns == UINT64_MAX)
+         ret = pthread_cond_wait(&device->timeline_cond, &device->submit_mutex);
+      else
+         ret = pthread_cond_timedwait(&device->timeline_cond, &device->submit_mutex, &abstime);
+      if (ret != 0) {
+         pthread_mutex_unlock(&device->submit_mutex);
+         return VK_TIMEOUT;
+      }
+   }
+   pthread_mutex_unlock(&device->submit_mutex);
+   return VK_SUCCESS;
+}
+
 static VkResult
